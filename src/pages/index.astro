---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import ShopCard from "../components/ShopCard.astro";
import SearchDialog from "../components/SearchDialog.astro";
import { siteConfig } from "../config/site";
import { withBase } from "../lib/urls";
import { allTagsOf } from "../lib/shops";
import { buildSearchIndex } from "../lib/search-index";
import heroImage from "../assets/hero.jpg";
import Icon from "../components/Icon.astro";

const shops = (await getCollection("restaurants")).sort((a, b) => a.data.name.localeCompare(b.data.name, "zh"));
const samples = shops.filter((shop) => shop.data.sample).length;

// 跑马灯直接用站内标签，点一下就能跳到对应的筛选结果
const marqueeItems = allTagsOf(shops);

// 首页也能直接搜菜名，不用先跳转
const searchIndex = buildSearchIndex(shops);

// 区块编号按实际渲染的区块算，跳过哪个都不会跳号
const steps = [shops.length > 0 && "all", "submit"].filter(Boolean) as string[];
const no = (key: string) => String(steps.indexOf(key) + 1).padStart(2, "0");

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteConfig.name,
  description: siteConfig.description,
  url: new URL(import.meta.env.BASE_URL, Astro.site ?? "https://asaberui1.github.io").href,
  inLanguage: "zh-CN",
};
---

<BaseLayout description={siteConfig.description} image={siteConfig.defaultImage} structuredData={structuredData}>
  <Nav />

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <Image
        class="media-fill"
        src={heroImage}
        alt="海边盛开的三角梅，一只黄色蝴蝶停在花上"
        widths={[960, 1440, 2000]}
        sizes="100vw"
        loading="eager"
        decoding="sync"
        fetchpriority="high"
      />
      <div class="overlay" style="background: var(--grad-vignette);"></div>
      <div class="overlay" style="background: var(--grad-veil);"></div>
      <div class="hero-content">
        <div class="hero-grid">
          <div class="hero-heading">
            <p class="label-eyebrow reveal">{siteConfig.school.name} · 周边食单</p>
            <h1 id="hero-title" class="hero-title display reveal reveal-delay-1">
              在创智，<br />
              <span style="color: var(--ember);">好好吃饭</span>
            </h1>
          </div>

          <div class="hero-copy reveal reveal-delay-2">
            <p>
              步行二十分钟、骑车八分钟以内的店，我们一家一家吃过去：环境是随手拍的，价格是自己付的，推荐菜是回头还会再点的那一道。
            </p>
            <div class="hero-actions">
              <a class="button-link" href={withBase("/restaurants/")}>
                看看附近有什么 <Icon name="arrow-right" />
              </a>
              <a class="text-link" href={withBase("/about/")}>这个站怎么来的</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="marquee" aria-label="收录的品类">
      <div class="marquee-track">
        {
          [...marqueeItems, ...marqueeItems].map((item) => (
            <a class="marquee__item" href={`${withBase("/restaurants/")}?tag=${encodeURIComponent(item)}`}>
              {item}
              <svg class="marquee__dot" width="8" height="8" viewBox="0 0 8 8" aria-hidden="true">
                <circle cx="4" cy="4" r="3.2" fill="currentColor"></circle>
              </svg>
            </a>
          ))
        }
      </div>
    </section>

    {
      shops.length === 0 ? (
        <section class="section">
          <div class="container empty-state">
            <p class="label-eyebrow">00 — 空</p>
            <h2 class="display">这里还没有店。</h2>
            <p>第一张照片、第一份菜单放进来之后，这个页面就会热闹起来。</p>
          </div>
        </section>
      ) : (
        <>
          <section class="section surface-section" aria-labelledby="random-title">
            <div class="container">
              <header class="section-head">
                <p class="label-eyebrow reveal">{no("all")} — 随机推荐</p>
                <h2 id="random-title" class="section-title display reveal">
                  还没想好吃什么？
                </h2>
                <p class="section-note reveal">
                  下面这三家是随机刷新的；想按口味找，去<a href={withBase("/restaurants/")}>全部餐馆</a>慢慢逛。
                </p>
              </header>

              <div class="home-actions reveal">
                <button type="button" class="button-link" data-search-open>
                  只想吃某道菜？搜菜名
                </button>
                <button type="button" class="reshuffle" data-reshuffle>
                  换一批 <Icon name="refresh" size={15} />
                </button>
              </div>

              <div class="shop-grid" data-random-picks>
                {shops.map((shop) => (
                  <div class="reveal" data-pick>
                    <ShopCard shop={shop} />
                  </div>
                ))}
              </div>
            </div>
          </section>
        </>
      )
    }

    <section class="section reservation" aria-labelledby="submit-title">
      <div class="container section-grid">
        <div class="reservation-copy">
          <p class="label-eyebrow reveal">{no("submit")} — 投稿</p>
          <h2 id="submit-title" class="display reveal">
            你常去的那家，<br />
            <span style="color: var(--ember);">也值得被记下来</span>
          </h2>
          <p class="reveal reveal-delay-1">
            有想推荐的店、发现菜单变了、或者哪家已经关门，都可以直接说。附上照片和大概人均就更好。
          </p>
          <div class="hero-actions reveal reveal-delay-2">
            <a class="button-link" href={siteConfig.contact.issue} target="_blank" rel="noreferrer">
              去 GitHub 投稿 <Icon name="arrow-right" />
            </a>
            <a
              class="button-link button-link--outline"
              href={siteConfig.contact.repo}
              target="_blank"
              rel="noreferrer"
            >
              <Icon name="star" size={15} /> 给个 Star
            </a>
          </div>
        </div>
        <div class="reservation-facts reveal">
          <div>
            <p class="label-eyebrow">当前收录</p>
            <p>{shops.length} 家{samples > 0 ? `（其中 ${samples} 家为示例）` : ""}</p>
          </div>
          <div>
            <p class="label-eyebrow">范围</p>
            <p>{siteConfig.school.note}</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <SearchDialog index={searchIndex} />

  <script is:inline>
    (() => {
      const grid = document.querySelector("[data-random-picks]");
      if (!grid) return;

      const items = Array.from(grid.children);
      if (items.length <= 3) return;

      const pick = () => {
        const picked = new Set();
        while (picked.size < 3) picked.add(Math.floor(Math.random() * items.length));

        const shown = [];
        items.forEach((item, index) => {
          const visible = picked.has(index);
          item.hidden = !visible;
          if (visible) shown.push(item);
        });

        // 重新播放一次出场动画：先收起，强制重排，再依次放出来
        shown.forEach((item) => item.classList.remove("is-visible"));
        void grid.offsetWidth;
        requestAnimationFrame(() => {
          shown.forEach((item, index) => {
            window.setTimeout(() => item.classList.add("is-visible"), index * 90);
          });
        });
      };

      pick();
      document.querySelector("[data-reshuffle]")?.addEventListener("click", pick);

      // 跑马灯：字体加载完再启动动画，避免首屏字宽变化造成的“瞬移”
      const marquee = document.querySelector(".marquee");
      const track = document.querySelector(".marquee-track");
      if (marquee && track) {
        document.fonts.ready.then(() => {
          marquee.classList.add("is-ready");

          if (typeof track.getAnimations === "function") {
            const setPaused = (paused) => {
              track.getAnimations().forEach((animation) => {
                if (paused) animation.pause();
                else animation.play();
              });
            };
            marquee.addEventListener("mouseenter", () => setPaused(true));
            marquee.addEventListener("mouseleave", () => setPaused(false));
            marquee.addEventListener("focusin", () => setPaused(true));
            marquee.addEventListener("focusout", () => setPaused(false));
          }
        });
      }
    })();
  </script>
</BaseLayout>
