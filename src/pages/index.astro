---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import ShopCard from "../components/ShopCard.astro";
import SearchDialog from "../components/SearchDialog.astro";
import { siteConfig } from "../config/site";
import { withBase } from "../lib/urls";
import { allTagsOf } from "../lib/shops";
import heroImage from "../assets/hero.jpg";
import Icon from "../components/Icon.astro";

const shops = (await getCollection("restaurants")).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.name.localeCompare(b.data.name, "zh"),
);

const featured = shops.filter((shop) => shop.data.featured).slice(0, 3);
// 只有一条「精选」时不上单独的精选区，避免一列大图孤零零地挂着
const showFeatured = featured.length >= 2;
const samples = shops.filter((shop) => shop.data.sample).length;

// 跑马灯直接用站内标签，点一下就能跳到对应的筛选结果
const marqueeItems = allTagsOf(shops);

// 首页也能直接搜菜名，不用先跳转
const searchIndex = shops.map((shop) => ({
  id: shop.id,
  name: shop.data.name,
  menu: shop.data.menu.flatMap((group) =>
    group.items.map((item) => ({ name: item.name, price: item.price, group: group.title })),
  ),
}));

// 区块编号按实际渲染的区块算，跳过哪个都不会跳号
const steps = [
  showFeatured && "recent",
  shops.length > 0 && "all",
  "method",
  "submit",
].filter(Boolean) as string[];
const no = (key: string) => String(steps.indexOf(key) + 1).padStart(2, "0");

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteConfig.name,
  description: siteConfig.description,
  url: new URL(import.meta.env.BASE_URL, Astro.site ?? "https://asaberui1.github.io").href,
  inLanguage: "zh-CN",
};
---

<BaseLayout description={siteConfig.description} image={siteConfig.defaultImage} structuredData={structuredData}>
  <Nav />

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <Image
        class="media-fill"
        src={heroImage}
        alt="海边盛开的三角梅，一只黄色蝴蝶停在花上"
        widths={[960, 1440, 2000]}
        sizes="100vw"
        loading="eager"
        decoding="sync"
      />
      <div class="overlay" style="background: var(--grad-vignette);"></div>
      <div class="overlay" style="background: var(--grad-veil);"></div>
      <div class="hero-content">
        <div class="hero-grid">
          <div class="hero-heading">
            <p class="label-eyebrow reveal">{siteConfig.school.name} · 周边食单</p>
            <h1 id="hero-title" class="hero-title display reveal reveal-delay-1">
              在创智，<br />
              <span style="color: var(--ember);">好好吃饭</span>
            </h1>
          </div>

          <div class="hero-copy reveal reveal-delay-2">
            <p>
              步行二十分钟、骑车八分钟以内的店，我们一家一家吃过去：环境是随手拍的，价格是自己付的，推荐菜是回头还会再点的那一道。
            </p>
            <div class="hero-actions">
              <a class="button-link" href={withBase("/restaurants/")}>
                看看附近有什么 <Icon name="arrow-right" />
              </a>
              <a class="text-link" href={withBase("/about/")}>这个站怎么来的</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="marquee" aria-label="收录的品类">
      <div class="marquee-track">
        {
          [...marqueeItems, ...marqueeItems].map((item) => (
            <a class="marquee__item" href={`${withBase("/restaurants/")}?tag=${encodeURIComponent(item)}`}>
              {item}
              <b aria-hidden="true">*</b>
            </a>
          ))
        }
      </div>
    </section>

    {
      shops.length === 0 ? (
        <section class="section">
          <div class="container empty-state">
            <p class="label-eyebrow">00 — 空</p>
            <h2 class="display">这里还没有店。</h2>
            <p>第一张照片、第一份菜单放进来之后，这个页面就会热闹起来。</p>
          </div>
        </section>
      ) : (
        <>
          {showFeatured && (
            <section class="section" aria-labelledby="featured-title">
              <div class="container">
                <header class="section-head">
                  <p class="label-eyebrow reveal">{no("recent")} — 最近吃过</p>
                  <h2 id="featured-title" class="section-title display reveal">
                    这个月，
                    <span style="color: var(--ember);">值得再去</span>的几家
                  </h2>
                </header>
                <div class="shop-grid shop-grid--featured">
                  {featured.map((shop, index) => (
                    <div class:list={["reveal", index === 0 && "shop-grid__lead"]}>
                      <ShopCard shop={shop} large={index === 0} />
                    </div>
                  ))}
                </div>
              </div>
            </section>
          )}

          <section class="section surface-section" aria-labelledby="random-title">
            <div class="container">
              <header class="section-head">
                <p class="label-eyebrow reveal">{no("all")} — 随机推荐</p>
                <h2 id="random-title" class="section-title display reveal">
                  还没想好吃什么？
                </h2>
                <p class="section-note reveal">
                  下面这三家是随机挑的，点「换一批」或者刷新页面都会重新抽；想按口味找，去全部餐馆慢慢逛。
                </p>
              </header>

              <div class="home-actions reveal">
                <a class="button-link" href={withBase("/restaurants/")}>
                  查看全部 {shops.length} 家 <Icon name="arrow-right" />
                </a>
                <button type="button" class="button-link" data-search-open>
                  只想吃某道菜？搜菜名
                </button>
                <button type="button" class="reshuffle" data-reshuffle>
                  换一批 <Icon name="refresh" size={15} />
                </button>
              </div>

              <div class="shop-grid" data-random-picks>
                {shops.map((shop) => (
                  <div class="reveal" data-pick>
                    <ShopCard shop={shop} />
                  </div>
                ))}
              </div>
            </div>
          </section>
        </>
      )
    }

    <section class="section" aria-labelledby="method-title">
      <div class="container">
        <header class="section-head">
          <p class="label-eyebrow reveal">{no("method")} — 怎么写的</p>
          <h2 id="method-title" class="section-title display reveal">
            吃过的，<span style="color: var(--ember);">才写</span>。
          </h2>
        </header>

        <div class="feature-grid">
          <section class="reveal">
            <p class="label-eyebrow">亲自吃过</p>
            <p>每一家都至少去过两次，一次吃招牌，一次点别的。</p>
          </section>
          <section class="reveal reveal-delay-1">
            <p class="label-eyebrow">价格对得上小票</p>
            <p>多人聚餐记实际结账的金额；单人餐只列菜单，丰俭由人。</p>
          </section>
          <section class="reveal reveal-delay-2">
            <p class="label-eyebrow">照片不修图</p>
            <p>手机原图，室内偏暗就是偏暗，不补光。</p>
          </section>
        </div>
      </div>
    </section>

    <section class="section reservation" aria-labelledby="submit-title">
      <div class="container section-grid">
        <div class="reservation-copy">
          <p class="label-eyebrow reveal">{no("submit")} — 投稿</p>
          <h2 id="submit-title" class="display reveal">
            你常去的那家，<br />
            <span style="color: var(--ember);">也值得被记下来</span>
          </h2>
          <p class="reveal reveal-delay-1">
            有想推荐的店、发现菜单变了、或者哪家已经关门，都可以直接说。附上照片和大概人均就更好。
          </p>
          <div class="hero-actions reveal reveal-delay-2">
            <a class="button-link" href={`mailto:${siteConfig.contact.email}`}>
              写邮件投稿 <Icon name="arrow-right" />
            </a>
            <a class="text-link" href={withBase("/about/")}>收录标准</a>
          </div>
        </div>
        <div class="reservation-facts reveal">
          <div>
            <p class="label-eyebrow">当前收录</p>
            <p>{shops.length} 家{samples > 0 ? `（其中 ${samples} 家为示例）` : ""}</p>
          </div>
          <div>
            <p class="label-eyebrow">范围</p>
            <p>{siteConfig.school.note}</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <SearchDialog index={searchIndex} />

  <script is:inline>
    (() => {
      const grid = document.querySelector("[data-random-picks]");
      if (!grid) return;

      const items = Array.from(grid.children);
      if (items.length <= 3) return;

      const pick = () => {
        items.forEach((item) => {
          item.hidden = false;
        });

        const picked = new Set();
        while (picked.size < 3) picked.add(Math.floor(Math.random() * items.length));
        items.forEach((item, index) => {
          item.hidden = !picked.has(index);
        });
      };

      pick();
      document.querySelector("[data-reshuffle]")?.addEventListener("click", pick);
    })();
  </script>
</BaseLayout>
