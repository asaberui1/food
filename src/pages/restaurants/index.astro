---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import ShopCard from "../../components/ShopCard.astro";
import { siteConfig } from "../../config/site";
import { tagsOf } from "../../lib/shops";

const shops = (await getCollection("restaurants")).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.name.localeCompare(b.data.name, "zh"),
);

const samples = shops.filter((shop) => shop.data.sample).length;
const tagged = shops.map((shop) => ({ shop, tags: tagsOf(shop) }));

// 标签并列展示：品类在前，其次是自定义标签，最后是就餐方式
const cuisines = [...new Set(shops.map((shop) => shop.data.cuisine))];
const extraTags = [...new Set(shops.flatMap((shop) => shop.data.tags))].filter((tag) => !cuisines.includes(tag));
const diningTags = ["单人餐", "多人聚餐", "四六分餐馆"].filter((tag) =>
  shops.some((shop) => tagsOf(shop).includes(tag)),
);
const allTags = [...cuisines, ...extraTags, ...diningTags];

// 菜名搜索索引：只有录入了菜单的店才有可搜的菜名
const searchIndex = shops.map((shop) => ({
  id: shop.id,
  name: shop.data.name,
  cuisine: shop.data.cuisine,
  menu: shop.data.menu.flatMap((group) =>
    group.items.map((item) => ({ name: item.name, price: item.price, group: group.title })),
  ),
}));

// 每个品类只给第一张卡片挂锚点，供首页的品类链接跳转
const seen = new Set<string>();
---

<BaseLayout
  title="全部餐馆"
  description={`${siteConfig.school.name}周边已收录的 ${shops.length} 家餐馆，含人均、步行距离与推荐菜。`}
>
  <Nav />

  <main id="main">
    <section class="page-head">
      <div class="container page-head__inner">
        <p class="label-eyebrow">All entries</p>
        <h1 class="page-title display">全部餐馆</h1>
        <p class="page-lead">
          共 {shops.length} 家。多人聚餐标注人均和实际消费，单人餐只列菜单、丰俭由人；距离按从学院大门步行计算。
        </p>
        {samples > 0 && <p class="notice">其中 {samples} 家为示例条目，用于展示版式，正式收录后可替换或删除。</p>}
      </div>
    </section>

    <section class="section section--tight">
      <div class="container">
        {
          shops.length === 0 ? (
            <div class="empty-state">
              <h2 class="display">还没有记录。</h2>
              <p>把第一家店的照片和菜单发过来，这里就会有内容。</p>
            </div>
          ) : (
            <>
              <div class="filter-bar" data-filters>
                <div class="filter-head">
                  <p class="label-eyebrow">点标签筛选，可多选</p>
                  <button type="button" class="search-button" data-search-open>
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <circle cx="11" cy="11" r="7"></circle>
                      <path d="M16.5 16.5L21 21"></path>
                    </svg>
                    搜菜名
                  </button>
                </div>

                <div class="tag-row tag-row--filter" role="group" aria-label="按标签筛选">
                  {allTags.map((tag) => (
                    <button type="button" class="chip" data-tag={tag} aria-pressed="false">
                      {tag}
                    </button>
                  ))}
                </div>

                <p class="search-hint">
                  「四六分餐馆」：一个人来能吃，四五个人点一桌炒菜也行。菜名搜索只覆盖已录入菜单的店。
                </p>
              </div>

              <p class="search-status" data-status hidden></p>

              <div class="shop-grid shop-grid--list">
                {tagged.map(({ shop, tags }) => {
                  const isFirst = !seen.has(shop.data.cuisine);
                  seen.add(shop.data.cuisine);
                  return (
                    <div
                      id={isFirst ? shop.data.cuisine : undefined}
                      class="anchor-target"
                      data-shop
                      data-id={shop.id}
                      data-tags={tags.join("|")}
                    >
                      <ShopCard shop={shop} />
                    </div>
                  );
                })}
              </div>

              <p class="filter-empty" data-empty hidden>没有同时满足这些标签的店，试试取消一个。</p>
            </>
          )
        }
      </div>
    </section>
  </main>

  <Footer />

  <dialog class="search-dialog" data-search-dialog data-base={import.meta.env.BASE_URL} aria-labelledby="search-title">
    <div class="search-dialog__inner">
      <div class="search-dialog__head">
        <h2 id="search-title" class="search-dialog__title">搜菜名</h2>
        <button type="button" class="search-dialog__close" data-search-close aria-label="关闭搜索">关闭</button>
      </div>

      <label class="search-field">
        <span class="label-eyebrow">菜名或店名</span>
        <input
          type="search"
          name="dish"
          data-search
          placeholder="椒盐排条、牛蛙、盖浇饭…"
          autocomplete="off"
          spellcheck="false"
        />
      </label>
      <p class="search-hint">只有录入了菜单的店才会出现在菜名结果里。</p>

      <ul class="search-results" data-results></ul>
      <p class="search-hint" data-search-empty hidden>没有找到。换个菜名试试，或者直接用上面的标签筛。</p>
    </div>
  </dialog>

  <script type="application/json" id="shop-index" set:html={JSON.stringify(searchIndex)} />

  <script is:inline>
    (() => {
      const root = document.querySelector("[data-filters]");
      const dialog = document.querySelector("[data-search-dialog]");
      const status = document.querySelector("[data-status]");
      const emptyTip = document.querySelector("[data-empty]");
      const indexNode = document.getElementById("shop-index");
      if (!root || !dialog || !indexNode) return;

      const cards = Array.from(document.querySelectorAll("[data-shop]"));
      const shops = JSON.parse(indexNode.textContent);
      const byId = new Map(shops.map((shop) => [shop.id, shop]));
      const selected = new Set();

      // ---- 标签筛选 ----
      const renderFilter = () => {
        let visible = 0;

        cards.forEach((card) => {
          const tags = (card.dataset.tags || "").split("|");
          const ok = selected.size === 0 || tags.some((tag) => selected.has(tag));
          card.hidden = !ok;
          if (ok) visible += 1;
        });

        if (status) {
          status.hidden = selected.size === 0;
          status.textContent = selected.size > 0 ? `筛出 ${visible} 家` : "";
        }
        if (emptyTip) emptyTip.hidden = visible > 0;
      };

      root.querySelectorAll("[data-tag]").forEach((button) => {
        button.addEventListener("click", () => {
          const tag = button.dataset.tag;
          if (selected.has(tag)) selected.delete(tag);
          else selected.add(tag);
          button.classList.toggle("is-active", selected.has(tag));
          button.setAttribute("aria-pressed", String(selected.has(tag)));
          renderFilter();
        });
      });

      // ---- 菜名搜索（对话框）----
      const base = dialog.dataset.base || "/";
      const input = dialog.querySelector("[data-search]");
      const results = dialog.querySelector("[data-results]");
      const noResult = dialog.querySelector("[data-search-empty]");
      const normalize = (value) => (value || "").toLowerCase().replace(/\s+/g, "");

      // 先按子串命中；再把查询当成按顺序出现的字，允许中间隔字
      const matches = (text, query) => {
        const target = normalize(text);
        if (!query) return false;
        if (target.includes(query)) return true;
        let cursor = 0;
        for (const char of target) {
          if (char === query[cursor]) cursor += 1;
          if (cursor === query.length) return true;
        }
        return false;
      };

      const renderSearch = () => {
        const query = normalize(input.value);
        results.replaceChildren();
        noResult.hidden = true;
        if (!query) return;

        let count = 0;
        shops.forEach((shop) => {
          const hits = shop.menu.filter((item) => matches(`${item.name}${item.group}`, query));
          const nameHit = matches(shop.name, query);
          if (!hits.length && !nameHit) return;
          count += 1;

          const li = document.createElement("li");
          li.className = "search-result";

          const link = document.createElement("a");
          link.href = `${base}restaurants/${shop.id}/`;
          link.className = "search-result__name";
          link.textContent = shop.name;
          li.append(link);

          const unique = [...new Set(hits.map((item) => `${item.name} ${item.price}`))].slice(0, 6);
          if (unique.length) {
            const detail = document.createElement("p");
            detail.className = "search-result__dishes";
            detail.textContent = unique.join("、") + (hits.length > 6 ? " 等" : "");
            li.append(detail);
          }

          results.append(li);
        });

        noResult.hidden = count > 0;
      };

      const openSearch = () => {
        if (typeof dialog.showModal === "function") dialog.showModal();
        else dialog.setAttribute("open", "");
        input.value = "";
        results.replaceChildren();
        noResult.hidden = true;
        window.setTimeout(() => input.focus(), 30);
      };

      const closeSearch = () => {
        if (typeof dialog.close === "function") dialog.close();
        else dialog.removeAttribute("open");
      };

      const openButton = root.querySelector("[data-search-open]");
      if (openButton) openButton.addEventListener("click", openSearch);
      dialog.querySelector("[data-search-close]").addEventListener("click", closeSearch);
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) closeSearch();
      });
      input.addEventListener("input", renderSearch);
    })();
  </script>
</BaseLayout>
