---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import ShopCard from "../../components/ShopCard.astro";
import ShopMapModal from "../../components/ShopMapModal.astro";
import SearchDialog from "../../components/SearchDialog.astro";
import { siteConfig } from "../../config/site";
import { allTagsOf, tagsOf } from "../../lib/shops";

// 按店名拼音排，不再按收录时间
const shops = (await getCollection("restaurants")).sort((a, b) =>
  a.data.name.localeCompare(b.data.name, "zh"),
);
const tagged = shops.map((shop) => ({ shop, tags: tagsOf(shop) }));
// 有菜单才有可搜的菜名
const withMenu = shops.filter((shop) => shop.data.menu.length > 0).length;
const allTags = allTagsOf(shops);

// 菜名搜索索引：只有录入了菜单的店才有可搜的菜名

// 每个品类只给第一张卡片挂锚点，供首页的品类链接跳转
const seen = new Set<string>();
---

<BaseLayout
  title="全部餐馆"
  description={`${siteConfig.school.name}周边已收录的 ${shops.length} 家餐馆，含人均、步行距离与推荐菜。`}
>
  <Nav />

  <main id="main">
    <section class="page-head">
      <div class="container page-head__inner">
        <p class="label-eyebrow">All entries</p>
        <h1 class="page-title display">全部餐馆</h1>
        <p class="page-lead">
          共 {shops.length} 家。多人聚餐标注人均和实际消费，单人餐只列菜单、丰俭由人；距离按从学院大门步行计算。
        </p>
      </div>
    </section>

    <section class="section section--tight">
      <div class="container">
        {
          shops.length === 0 ? (
            <div class="empty-state">
              <h2 class="display">还没有记录。</h2>
              <p>把第一家店的照片和菜单发过来，这里就会有内容。</p>
            </div>
          ) : (
            <>
              <div class="filter-bar" data-filters>
                <div class="filter-head">
                  <div class="filter-lead">
                    <p class="label-eyebrow">点标签筛选</p>
                    <details class="filter-help">
                      <summary class="filter-help__btn" aria-label="「四六分餐馆」指什么">
                        <svg viewBox="0 0 20 20" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="butt" stroke-linejoin="round" aria-hidden="true">
                          <path d="M6.4 6.4a3.5 3.5 0 0 1 6.8 1.2c0 2.1-3.2 2.8-3.2 4.7v1.1"></path>
                          <rect x="8.8" y="15.4" width="2.4" height="2.4" fill="currentColor" stroke="none"></rect>
                        </svg>
                      </summary>
                      <p class="filter-help__pop">
                        「四六分餐馆」：一个人来能吃，四五好友小聚也行。人再多点、或者追求完整用餐体验就不太推荐了。
                      </p>
                    </details>
                  </div>
                  <div class="filter-actions">
                    <button type="button" class="search-button" data-search-open>
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="11" cy="11" r="7"></circle>
                        <path d="M16.5 16.5L21 21"></path>
                      </svg>
                      搜菜名
                    </button>
                    <a
                      class="map-button"
                      href={`${import.meta.env.BASE_URL}map/neighbourhood.svg`}
                      target="_blank"
                      rel="noopener"
                      data-map-open
                    >
                      <svg class="map-button__pin" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 2a7.2 7.2 0 0 0-7.2 7.2c0 5.1 5.7 11.2 6.6 12.2a.8.8 0 0 0 1.2 0c.9-1 6.6-7.1 6.6-12.2A7.2 7.2 0 0 0 12 2zm0 9.9a2.7 2.7 0 1 1 0-5.4 2.7 2.7 0 0 1 0 5.4z"></path>
                      </svg>
                      看地图
                    </a>
                  </div>
                </div>

                <div class="tag-row tag-row--filter" role="group" aria-label="按类别筛选">
                  {allTags.map((tag) => (
                    <a
                      class="chip"
                      href={`${import.meta.env.BASE_URL}restaurants/tag/${encodeURIComponent(tag)}/`}
                      data-tag={tag}
                      aria-pressed="false"
                    >
                      {tag}
                    </a>
                  ))}
                  <button type="button" class="chip chip--clear" data-clear-filter hidden>
                    清空筛选
                  </button>
                </div>

                <noscript>
                  <style>
                    .search-button {
                      display: none;
                    }
                  </style>
                  <p class="noscript-note">
                    筛选和搜菜名需要 JavaScript；不开也能直接往下翻，全部餐馆都在下面。
                  </p>
                </noscript>

              </div>

              <p class="search-status" data-status hidden></p>

              <div class="shop-grid shop-grid--list">
                {tagged.map(({ shop, tags }) => {
                  const isFirst = !seen.has(shop.data.cuisine);
                  seen.add(shop.data.cuisine);
                  return (
                    <div
                      id={isFirst ? shop.data.cuisine : undefined}
                      class="anchor-target"
                      data-shop
                      data-id={shop.id}
                      data-tags={tags.join("|")}
                    >
                      <ShopCard shop={shop} />
                    </div>
                  );
                })}
              </div>

              <p class="filter-empty" data-empty hidden>没有同时满足这些标签的店，试试取消一个。</p>
            </>
          )
        }
      </div>
    </section>
  </main>

  <Footer />

  <SearchDialog withMenu={withMenu} total={shops.length} />
  <ShopMapModal />

  <script is:inline>
    (() => {
      const root = document.querySelector("[data-filters]");
      const status = document.querySelector("[data-status]");
      const emptyTip = document.querySelector("[data-empty]");
      if (!root) return;

      const cards = Array.from(document.querySelectorAll("[data-shop]"));
      const selected = new Set();

      const clear = root.querySelector("[data-clear-filter]");

      const render = () => {
        let visible = 0;

        cards.forEach((card) => {
          const tags = (card.dataset.tags || "").split("|");
          // 多个标签之间取交集：都能满足才留下
          const ok = selected.size === 0 || [...selected].every((tag) => tags.includes(tag));
          card.hidden = !ok;
          if (ok) visible += 1;
        });

        if (status) {
          status.hidden = selected.size === 0;
          status.textContent = selected.size > 0 ? `筛出 ${visible} 家` : "";
        }
        if (emptyTip) emptyTip.hidden = visible > 0;
        if (clear) clear.hidden = selected.size === 0;
      };

      root.querySelectorAll("[data-tag]").forEach((button) => {
        button.addEventListener("click", (event) => {
          event.preventDefault();
          const tag = button.dataset.tag;
          if (selected.has(tag)) selected.delete(tag);
          else selected.add(tag);
          button.classList.toggle("is-active", selected.has(tag));
          button.setAttribute("aria-pressed", String(selected.has(tag)));
          render();
        });
      });

      clear?.addEventListener("click", () => {
        selected.clear();
        root.querySelectorAll("[data-tag]").forEach((button) => {
          button.classList.remove("is-active");
          button.setAttribute("aria-pressed", "false");
        });
        render();
      });

      // 问号说明：点别处或按 Esc 也收起
      const help = root.querySelector("details.filter-help");
      if (help) {
        document.addEventListener("click", (event) => {
          if (!help.open) return;
          if (help.contains(event.target)) return;
          help.open = false;
        });
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && help.open) {
            help.open = false;
            help.querySelector("summary")?.focus();
          }
        });
      }

      // 首页标签链接落到这里：/restaurants/?tag=xxx
      const initialTag = new URLSearchParams(window.location.search).get("tag");
      if (initialTag) {
        const button = Array.from(root.querySelectorAll("[data-tag]")).find(
          (element) => element.dataset.tag === initialTag,
        );
        if (button) button.click();
      }
    })();
  </script>
</BaseLayout>
