---
import { Picture, getImage } from "astro:assets";
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { siteConfig } from "../../config/site";
import { withBase } from "../../lib/urls";
import { averagePerPerson, billComposition, billPerPerson, priceLabel } from "../../lib/bills";
import Icon from "../../components/Icon.astro";
import Lightbox from "../../components/Lightbox.astro";
import ShareStudio from "../../components/ShareStudio.astro";
import ShopToc from "../../components/ShopToc.astro";

export async function getStaticPaths() {
  const shops = await getCollection("restaurants");
  return shops.map((shop) => ({ params: { slug: shop.id }, props: { shop } }));
}

type Props = { shop: CollectionEntry<"restaurants"> };

const { shop } = Astro.props;
const {
  name,
  cuisine,
  dining,
  walkMinutes,
  address,
  hours,
  far,
  summary,
  cover,
  gallery,
  dishes,
  menu,
  menuNote,
  bills,
  order,
} = shop.data;
const { Content } = await render(shop);

const hasBody = Boolean(shop.body?.trim());

// 列表里只显示小图；点开灯箱才去取大图
const galleryLarge = await Promise.all(
  gallery.map(async (photo) => ({
    ...photo,
    full: (await getImage({ src: photo.src, width: 1600, quality: 82, format: "webp" })).src,
  })),
);
const dishesLarge = await Promise.all(
  dishes.map(async (dish) =>
    dish.image
      ? {
          ...dish,
          full: (await getImage({ src: dish.image, width: 1200, quality: 82, format: "webp" })).src,
          thumb: (await getImage({ src: dish.image, width: 200, quality: 70, format: "webp" })).src,
        }
      : { ...dish, full: undefined, thumb: undefined },
  ),
);
// 菜单里带图的菜：点一下看大图，不算推荐菜。
// 推荐菜已经有图的，同名菜在菜单里也复用这张图，不再单独存一份。
const dishPhoto = new Map(
  dishesLarge.flatMap((dish) =>
    dish.full ? [[dish.name, dish.full] as const, [`${dish.name}#thumb`, dish.thumb] as const] : [],
  ),
);
const menuLarge = await Promise.all(
  menu.map(async (group) => ({
    ...group,
    items: await Promise.all(
      group.items.map(async (item) => {
        if (item.image) {
          const full = (await getImage({ src: item.image, width: 1400, quality: 82, format: "webp" })).src;
          const thumb = (await getImage({ src: item.image, width: 200, quality: 70, format: "webp" })).src;
          return { ...item, full, thumb };
        }
        return { ...item, full: dishPhoto.get(item.name), thumb: dishPhoto.get(`${item.name}#thumb`) };
      }),
    ),
  })),
);

const diningLabel =
  dining === "group" ? "多人聚餐" : dining === "single" ? "单人餐" : "聚餐 / 单人餐";

// 区块编号按实际渲染的区块算，缺哪个都不会跳号；同一份列表也给浮动目录用
const sections = [
  gallery.length > 0 && { id: "gallery-title", label: "环境" },
  dishes.length > 0 && { id: "dishes-title", label: "推荐菜" },
  (menu.length > 0 || order) && { id: "menu-title", label: "菜单" },
  hasBody && { id: "notes-title", label: "备注" },
  { id: "share-title", label: "分享" },
].filter(Boolean) as { id: string; label: string }[];
const step = (label: string) =>
  String(sections.findIndex((section) => section.label === label) + 1).padStart(2, "0");

// 价格可能是「¥98–208」或「¥18/小份」这类写法，取区间两端
// 价格按「/」分段，跳过 500克 这类单位，只留真正的价格
const priceNumbers = (price: string) =>
  price
    .split("/")
    .map((part) => {
      if (/(克|kg|ml|升)/i.test(part)) return Number.NaN;
      const match = part.match(/\d+(?:\.\d+)?/);
      return match ? Number(match[0]) : Number.NaN;
    })
    .filter((value) => Number.isFinite(value) && value > 0);
const menuGroups = menuLarge.map((group, groupIndex) => {
  const firsts: number[] = [];
  const lasts: number[] = [];
  for (const item of group.items) {
    const values = priceNumbers(item.price).filter((value) => value > 0);
    if (!values.length) continue;
    firsts.push(values[0]);
    lasts.push(values[values.length - 1]);
  }
  const min = firsts.length ? Math.min(...firsts) : null;
  const max = lasts.length ? Math.max(...lasts) : null;
  const allMarketPrice = group.items.length > 0 && group.items.every((item) => item.price.includes("时价"));
  const range =
    min === null ? (allMarketPrice ? "时价" : "") : min === max ? `¥${min}` : `¥${min}–${max}`;
  return { ...group, groupIndex, range };
});

const priceText = priceLabel(shop);
const billsAverage = averagePerPerson(bills);
const distanceText = walkMinutes
  ? `步行 ${walkMinutes} 分钟`
  : far
    ? "步行 20 分钟以外"
    : "待补充";

const siteUrl = Astro.site ?? new URL("https://asaberui1.github.io");
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Restaurant",
  name,
  description: summary,
  url: pageUrl,
  servesCuisine: cuisine,
  ...(billsAverage ? { priceRange: `¥${billsAverage}` } : {}),
  hasMenu: `${pageUrl}#menu-title`,
  address: { "@type": "PostalAddress", streetAddress: address, addressCountry: "CN" },
  ...(hours ? { openingHours: hours } : {}),
  // 有封面才写 image，没拍就先空着
  ...(cover ? { image: new URL(cover.src, siteUrl).href } : {}),
};
---

<BaseLayout
  title={name}
  description={`${name}：${summary}（${cuisine} · ${diningLabel}${priceText ? ` · ${priceText}` : ""}）`}
  image={`share/${shop.id}.jpg`}
  imageWidth={1080}
  imageHeight={1440}
  type={"article" as const}
  structuredData={structuredData}
>
  <Nav />

  <main id="main">
    <ShopToc sections={sections} />

    <article class="shop">
      <header class:list={["shop-hero", { "shop-hero--plain": !cover }]}>
        {
          cover && (
            <>
              <Picture
          formats={["avif", "webp"]}
          fallbackFormat="webp"
                class="media-fill"
                src={cover}
                alt={`${name} 的店内环境`}
                widths={[960, 1440, 2000]}
                sizes="100vw"
                loading="eager"
                decoding="sync"
              />
              <div class="overlay" style="background: var(--grad-vignette);"></div>
              <div class="overlay" style="background: var(--grad-shop-veil);"></div>
            </>
          )
        }

        <div class="shop-hero__content">
          <p class="label-eyebrow">{cuisine} · {diningLabel}</p>
          <h1 class="shop-title display">{name}</h1>
          <p class="shop-summary">{summary}</p>
        </div>
      </header>

      <div class="container">
        <dl class="shop-meta">
          <div>
            <dt class="label-eyebrow">人均</dt>
            <dd>{priceText}</dd>
          </div>
          <div>
            <dt class="label-eyebrow">距离</dt>
            <dd>{distanceText}</dd>
          </div>
          <div>
            <dt class="label-eyebrow">营业</dt>
            <dd>{hours || "未记录"}</dd>
          </div>
          <div>
            <dt class="label-eyebrow">地址</dt>
            <dd>{address}</dd>
          </div>
        </dl>

        {
          bills.length > 0 && (
            <details class="bill-block">
              <summary class="bill-block__head">
                <span class="label-eyebrow">消费记录</span>
                <span class="bill-block__meta">
                  {bills.length} 次 · 人均约 ¥{billsAverage}
                </span>
                <span class="bill-block__chev"><Icon name="chevron" size={13} /></span>
              </summary>
              <p class="bill-caption">按人数看分量；点开标签看具体点了哪些菜</p>
              <table class="bill-table">
                <thead>
                  <tr>
                    <th scope="col">人数</th>
                    <th scope="col">菜品</th>
                    <th scope="col">金额</th>
                  </tr>
                </thead>
                <tbody>
                  {bills.map((record, index) => (
                    <tr>
                      <td>{record.people} 人</td>
                      <td>
                        <span class="bill-dish">
                          <button
                            type="button"
                            class="bill-dish__button"
                            popovertarget={`bill-${shop.id}-${index}`}
                            aria-expanded="false"
                          >
                            {billComposition(record)}
                          </button>
                          <span class="bill-dish__popover" id={`bill-${shop.id}-${index}`} popover>
                            {record.dishes.join("、")}
                          </span>
                        </span>
                      </td>
                      <td class="bill-amount">
                        ¥{record.total}
                        <span class="bill-amount__per">人均 ¥{billPerPerson(record)}</span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </details>
          )
        }

        {
          gallery.length > 0 && (
            <section class="shop-section" aria-labelledby="gallery-title">
              <div class="shop-section__head">
                <p class="label-eyebrow">{step("环境")} — 环境</p>
                <h2 id="gallery-title" class="display">坐下来，先看看店</h2>
              </div>
              {gallery.length > 1 ? (
                <div class="gallery gallery--carousel" data-gallery>
                  <div class="gallery__viewport" data-gallery-viewport>
                    <div class="gallery__track" data-gallery-track>
                      {galleryLarge.map((photo) => (
                        <figure class="gallery__item" data-gallery-slide>
                          <a class="lightbox-link" href={photo.full} target="_blank" rel="noopener">
                            <Picture
                              formats={["avif", "webp"]}
                              fallbackFormat="webp"
                              src={photo.src}
                              alt={photo.alt}
                              widths={[480, 960]}
                              sizes="(min-width: 900px) 50vw, 100vw"
                              loading="lazy"
                              decoding="async"
                              data-lightbox
                              data-full={photo.full}
                            />
                          </a>
                        </figure>
                      ))}
                    </div>
                    <div class="gallery__zone gallery__zone--prev" aria-hidden="true"></div>
                    <div class="gallery__zone gallery__zone--next" aria-hidden="true"></div>
                    <button type="button" class="gallery__arrow-btn gallery__arrow-btn--prev" data-gallery-prev aria-label="上一张照片">
                      <svg viewBox="0 0 62 52" width="58" height="50" fill="none" stroke="currentColor" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M56 5 36 26l20 21 -8 0L28 26l20-21z"></path>
                        <path d="M34 5 14 26l20 21 -8 0L6 26l20-21z"></path>
                      </svg>
                    </button>
                    <button type="button" class="gallery__arrow-btn gallery__arrow-btn--next" data-gallery-next aria-label="下一张照片">
                      <svg viewBox="0 0 62 52" width="58" height="50" fill="none" stroke="currentColor" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M6 5l20 21L6 47l8 0 20-21L14 5z"></path>
                        <path d="M28 5l20 21L28 47l8 0 20-21L36 5z"></path>
                      </svg>
                    </button>
                  </div>
                  <div class="gallery__dots" data-gallery-dots role="group" aria-label="环境照片">
                    {gallery.map((photo, index) => (
                      <button
                        type="button"
                        class="gallery__dot"
                        data-gallery-dot
                        aria-label={`第 ${index + 1} 张照片`}
                      ></button>
                    ))}
                  </div>
                </div>
              ) : (
                <div class="gallery gallery--single">
                  {galleryLarge.map((photo) => (
                    <figure class="gallery__item">
                      <a class="lightbox-link" href={photo.full} target="_blank" rel="noopener">
                        <Picture
                          formats={["avif", "webp"]}
                          fallbackFormat="webp"
                          src={photo.src}
                          alt={photo.alt}
                          widths={[480, 960]}
                          sizes="(min-width: 900px) 50vw, 100vw"
                          loading="lazy"
                          decoding="async"
                          data-lightbox
                          data-full={photo.full}
                        />
                      </a>
                    </figure>
                  ))}
                </div>
              )}
            </section>
          )
        }

        {
          dishes.length > 0 && (
            <section class="shop-section" aria-labelledby="dishes-title">
              <div class="shop-section__head">
                <p class="label-eyebrow">{step("推荐菜")} — 推荐菜</p>
                <h2 id="dishes-title" class="display">回头还会再点的</h2>
              </div>
              <ol class="dish-list">
                {dishesLarge.map((dish, index) => (
                  <li class:list={["dish", { "dish--with-media": Boolean(dish.image) }]}>
                    <span class="dish__no">{String(index + 1).padStart(2, "0")}</span>
                    <div class="dish__body">
                      <h3 class="dish__name">
                        {dish.name}
                        {dish.price && <span class="dish__price">{dish.price}</span>}
                      </h3>
                      {dish.note && <p class="dish__note">{dish.note}</p>}
                    </div>
                    {dish.image && (
                      <div class="dish__media">
                        <a class="lightbox-link" href={dish.full} target="_blank" rel="noopener">
                        <Picture
          formats={["avif", "webp"]}
          fallbackFormat="webp"
                          src={dish.image}
                          alt={dish.name}
                          widths={[160, 320]}
                          sizes="120px"
                          loading="lazy"
                          decoding="async"
                          data-lightbox
                          data-full={dish.full}
                        />
                        </a>
                      </div>
                    )}
                  </li>
                ))}
              </ol>
            </section>
          )
        }

        {
          (menu.length > 0 || order) && (
            <section class="shop-section" aria-labelledby="menu-title">
              <div class="shop-section__head">
                <p class="label-eyebrow">{step("菜单")} — 菜单</p>
                <h2 id="menu-title" class="display">价目与点单</h2>
              </div>

              {menu.length > 0 && (
                <>
                {menuNote && <p class="menu-acc__intro">{menuNote}</p>}
                <div class="menu-acc-list">
                  {menuGroups.map((group) => (
                    <details class="menu-acc" id={`menu-${group.groupIndex}`}>
                      <summary class="menu-acc__head">
                        <span class="menu-acc__title">{group.title}</span>
                        <span class="menu-acc__range">{group.range}</span>
                        <span class="menu-acc__count">{group.items.length} 道</span>
                        <span class="menu-acc__chev"><Icon name="chevron" size={13} /></span>
                      </summary>
                      <div class="menu-acc__body">
                        {group.note && <p class="menu-acc__note">{group.note}</p>}
                        <ul class="menu-items">
                          {group.items.map((item, itemIndex) => {
                            const noteId = `menu-note-${shop.id}-${group.groupIndex}-${itemIndex}`;
                            return item.full ? (
                              item.note ? (
                                <li class="menu-item has-photo" data-menu-dish={item.name}>
                                  <button
                                    type="button"
                                    class="menu-item__name-trigger"
                                    data-lightbox
                                    data-full={item.full}
                                    data-thumb={item.thumb}
                                    data-alt={item.name}
                                    aria-label={`查看${item.name}的照片`}
                                  >
                                    <span class="menu-item__name is-photo">{item.name}</span>
                                  </button>
                                  <button
                                    type="button"
                                    class="menu-item__note"
                                    popovertarget={noteId}
                                    aria-label={`查看${item.name}的说明`}
                                    aria-expanded="false"
                                  >
                                    <Icon name="info" size={24} />
                                  </button>
                                  <button
                                    type="button"
                                    class="menu-item__photo-trigger"
                                    data-lightbox
                                    data-full={item.full}
                                    data-thumb={item.thumb}
                                    data-alt={item.name}
                                    aria-label={`查看${item.name}的照片`}
                                  >
                                    <span class="menu-item__photo" aria-hidden="true">
                                      <Icon name="photo" size={24} />
                                    </span>
                                  </button>
                                  <span class="menu-item__leader" aria-hidden="true"></span>
                                  <span class="menu-item__price">{item.price}</span>
                                  <span class="menu-note" id={noteId} popover role="tooltip">{item.note}</span>
                                </li>
                              ) : (
                                <li class="menu-item menu-item--photo has-photo" data-menu-dish={item.name}>
                                  <button
                                    type="button"
                                    class="menu-item__trigger"
                                    data-lightbox
                                    data-full={item.full}
                                    data-thumb={item.thumb}
                                    data-alt={item.name}
                                  >
                                    <span class="menu-item__name is-photo">{item.name}</span>
                                    <span class="menu-item__photo" aria-hidden="true">
                                      <Icon name="photo" size={24} />
                                    </span>
                                    <span class="menu-item__leader" aria-hidden="true"></span>
                                    <span class="menu-item__price">{item.price}</span>
                                  </button>
                                </li>
                              )
                            ) : (
                              <li class="menu-item" data-menu-dish={item.name}>
                                <span class="menu-item__name">{item.name}</span>
                                {item.note && (
                                  <button
                                    type="button"
                                    class="menu-item__note"
                                    popovertarget={noteId}
                                    aria-label={`查看${item.name}的说明`}
                                    aria-expanded="false"
                                  >
                                    <Icon name="info" size={24} />
                                  </button>
                                )}
                                <span class="menu-item__leader" aria-hidden="true"></span>
                                <span class="menu-item__price">{item.price}</span>
                                {item.note && (
                                  <span class="menu-note" id={noteId} popover role="tooltip">{item.note}</span>
                                )}
                              </li>
                            );
                          })}
                        </ul>
                      </div>
                    </details>
                  ))}
                </div>
                </>
              )}

              {order && (
                <div class="order-block">
                  {order.qr && (
                    <Picture
          formats={["avif", "webp"]}
          fallbackFormat="webp"
                      class="order-block__qr"
                      src={order.qr}
                      alt={`${name} 的扫码点餐二维码`}
                      widths={[240, 480]}
                      sizes="180px"
                      loading="lazy"
                    />
                  )}
                  <div class="order-block__copy">
                    <p class="label-eyebrow">扫码点餐</p>
                    <p>{order.note ?? "店内扫码点餐，菜单和价格以扫码页面为准。"}</p>
                    {order.tip && <p class="order-tip">{order.tip}</p>}
                    <p class="order-block__hint">
                      用微信或支付宝扫左边的码；这个页面是点餐小程序，电脑浏览器打不开。
                    </p>
                    {menu.length === 0 && <p class="menu-caveat">价目表待补充。</p>}
                  </div>
                </div>
              )}

              {menu.length > 0 && (
                <p class="menu-caveat">价格以最后一次到店为准，如有变动以店内为准。</p>
              )}
            </section>
          )
        }

        {
          hasBody && (
            <section class="shop-section" aria-labelledby="notes-title">
              <div class="shop-section__head">
                <p class="label-eyebrow">{step("备注")} — 备注</p>
                <h2 id="notes-title" class="display">去之前知道这些</h2>
              </div>
              <div class="prose">
                <Content />
              </div>
            </section>
          )
        }

        <section class="share-section" aria-labelledby="share-title">
          <div class="shop-section__head">
            <p class="label-eyebrow">{step("分享")} — 分享</p>
            <h2 id="share-title" class="display">存一张卡片带走</h2>
          </div>
          <figure class="share-card">
            <a
              class="lightbox-link"
              href={`${import.meta.env.BASE_URL}share/${shop.id}.jpg`}
              target="_blank"
              rel="noopener"
            >
            <img
              class="share-card__image"
              src={`${import.meta.env.BASE_URL}share/${shop.id}.jpg`}
              alt={`${name} 的默认分享卡`}
              width="1080"
              height="1350"
              loading="lazy"
              data-lightbox
            />
            </a>
            <div class="share-card__tools">
              {dishes.length > 0 && (
                <ShareStudio
                  triggerClass="share-tool"
                  triggerLabel="自定义"
                  triggerIcon="gear"
                  shop={shop}
                  menu={menu.map((group) => ({
                    title: group.title,
                    items: group.items.map((item) => ({ name: item.name, price: item.price })),
                  }))}
                  qr={`${import.meta.env.BASE_URL}qr/${shop.id}.png`}
                />
              )}
              <a
                class="share-tool share-tool--round"
                href={`${import.meta.env.BASE_URL}share/${shop.id}.jpg`}
                download={`${name}-创智食单.jpg`}
                aria-label={`下载「${name}」的默认分享卡`}
                title="下载默认分享卡"
              >
                <Icon name="download" size={17} />
              </a>
            </div>
          </figure>
        </section>

        <nav class="shop-foot" aria-label="页面导航">
          <a class="text-link" href={withBase("/restaurants/")}>
            <Icon name="arrow-left" /> 回到全部餐馆
          </a>
          <a
            class="text-link"
            href={`${siteConfig.contact.issue}&title=${encodeURIComponent(`关于「${name}」的补充`)}`}
            target="_blank"
            rel="noreferrer"
          >
            补充信息或纠错 <Icon name="arrow-right" />
          </a>
        </nav>
      </div>
    </article>
  </main>

  <Footer />

  <Lightbox />

  <script is:inline>
    (() => {
      const cells = Array.from(document.querySelectorAll(".bill-dish"));
      if (!cells.length) return;
      const margin = 12;
      const canHover = window.matchMedia("(hover: hover)").matches;
      const hasPopover = typeof HTMLElement.prototype.showPopover === "function";

      const place = (button, popover) => {
        const rect = button.getBoundingClientRect();
        const box = popover.getBoundingClientRect();

        let left = rect.left;
        if (left + box.width > window.innerWidth - margin) left = window.innerWidth - margin - box.width;
        if (left < margin) left = margin;

        let top = rect.bottom + 8;
        if (top + box.height > window.innerHeight - margin) top = rect.top - 8 - box.height;
        if (top < margin) top = margin;

        popover.style.left = `${left}px`;
        popover.style.top = `${top}px`;
      };

      cells.forEach((cell) => {
        const button = cell.querySelector(".bill-dish__button");
        const popover = cell.querySelector(".bill-dish__popover");
        if (!button || !popover) return;

        if (hasPopover) {
          // 原生 popover：Esc、点外面关闭、顶层显示都由浏览器负责
          popover.addEventListener("toggle", (event) => {
            button.setAttribute("aria-expanded", String(event.newState === "open"));
            if (event.newState === "open") place(button, popover);
          });

          if (canHover) {
            button.addEventListener("mouseenter", () => popover.showPopover());
            button.addEventListener("mouseleave", () => popover.hidePopover());
            button.addEventListener("focus", () => popover.showPopover());
            button.addEventListener("blur", () => popover.hidePopover());
          }
          return;
        }

        // 老浏览器：退回 hidden 开关
        const open = () => {
          popover.hidden = false;
          place(button, popover);
          button.setAttribute("aria-expanded", "true");
        };
        const close = () => {
          popover.hidden = true;
          button.setAttribute("aria-expanded", "false");
        };
        if (canHover) {
          button.addEventListener("mouseenter", open);
          button.addEventListener("mouseleave", close);
          button.addEventListener("focus", open);
          button.addEventListener("blur", close);
        }
        button.addEventListener("click", (event) => {
          event.preventDefault();
          if (popover.hidden) open();
          else close();
        });
        document.addEventListener("click", (event) => {
          if (event.target.closest(".bill-dish")) return;
          close();
        });
      });

      window.addEventListener("resize", () => {
        cells.forEach((cell) => {
          const popover = cell.querySelector(".bill-dish__popover");
          const button = cell.querySelector(".bill-dish__button");
          if (popover && !popover.hidden && popover.matches(":popover-open")) place(button, popover);
        });
      });
    })();
  </script>

  <script>
    document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((gallery) => {
      if (gallery.dataset.ready === "1") return;
      gallery.dataset.ready = "1";

      const viewport = gallery.querySelector<HTMLElement>("[data-gallery-viewport]");
      const track = gallery.querySelector<HTMLElement>("[data-gallery-track]");
      const realSlides = [...gallery.querySelectorAll<HTMLElement>("[data-gallery-slide]")];
      const dots = [...gallery.querySelectorAll<HTMLButtonElement>("[data-gallery-dot]")];
      const prev = gallery.querySelector<HTMLButtonElement>("[data-gallery-prev]");
      const next = gallery.querySelector<HTMLButtonElement>("[data-gallery-next]");

      if (!viewport || !track || realSlides.length < 2) return;

      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const count = realSlides.length;

      // 首尾各克隆一张：最后一张继续下一张、第一张继续上一张时，
      // 先滑到克隆图，再瞬时跳回真图，视觉上方向始终一致。
      const firstClone = realSlides[0].cloneNode(true) as HTMLElement;
      const lastClone = realSlides[count - 1].cloneNode(true) as HTMLElement;
      for (const clone of [firstClone, lastClone]) {
        clone.dataset.galleryClone = "1";
        clone.setAttribute("aria-hidden", "true");
        clone.setAttribute("inert", "");
        clone.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
          link.tabIndex = -1;
        });
      }
      track.append(firstClone);
      track.prepend(lastClone);

      let position = 1;
      let animating = false;
      let timer = 0;
      let settleTimer = 0;
      let paused = false;

      const setTransform = (animate: boolean): void => {
        track.style.transition =
          animate && !reduced ? "transform 420ms ease" : "none";
        track.style.transform = `translateX(-${position * 100}%)`;
      };

      const updateUi = (): void => {
        const activeIndex = (position - 1 + count) % count;

        realSlides.forEach((slide, i) => {
          const active = i === activeIndex;
          slide.toggleAttribute("inert", !active);
          slide.setAttribute("aria-hidden", String(!active));
          const link = slide.querySelector<HTMLAnchorElement>("a");
          if (link) link.tabIndex = active ? 0 : -1;
        });

        dots.forEach((dot, i) => {
          if (i === activeIndex) dot.setAttribute("aria-current", "true");
          else dot.removeAttribute("aria-current");
        });
      };

      const settle = (): void => {
        if (!animating) return;
        window.clearTimeout(settleTimer);

        if (position === count + 1) {
          position = 1;
          setTransform(false);
        } else if (position === 0) {
          position = count;
          setTransform(false);
        }

        animating = false;
        updateUi();
      };

      const afterMove = (): void => {
        window.clearTimeout(settleTimer);
        if (reduced) {
          settle();
          return;
        }
        setTransform(true);
        settleTimer = window.setTimeout(settle, 600);
      };

      const move = (delta: number): void => {
        if (animating) return;
        animating = true;
        position += delta;
        updateUi();
        afterMove();
      };

      const goTo = (target: number): void => {
        const current = (position - 1 + count) % count;
        if (animating || target === current) return;
        animating = true;
        position = target + 1;
        updateUi();
        afterMove();
      };

      const stop = (): void => {
        window.clearInterval(timer);
        timer = 0;
      };

      const start = (): void => {
        stop();
        if (reduced || paused) return;
        timer = window.setInterval(() => move(1), 5000);
      };

      track.addEventListener("transitionend", (event) => {
        if (event.propertyName !== "transform") return;
        settle();
      });

      gallery.classList.add("is-ready");
      setTransform(false);
      updateUi();
      start();

      prev?.addEventListener("click", () => move(-1));
      next?.addEventListener("click", () => move(1));
      dots.forEach((dot, i) => dot.addEventListener("click", () => goTo(i)));

      gallery.addEventListener("mouseenter", () => {
        paused = true;
        stop();
      });
      gallery.addEventListener("mouseleave", () => {
        paused = false;
        start();
      });
      gallery.addEventListener("focusin", () => {
        paused = true;
        stop();
      });
      gallery.addEventListener("focusout", () => {
        if (gallery.contains(document.activeElement)) return;
        paused = false;
        start();
      });

      document.addEventListener("visibilitychange", () => {
        if (document.hidden) stop();
        else if (!paused) start();
      });

      const edgeRatio = 0.16;
      const setEdgeHover = (event: PointerEvent): void => {
        const rect = viewport.getBoundingClientRect();
        const x = event.clientX - rect.left;
        gallery.classList.toggle(
          "is-hover-left",
          x >= 0 && x < rect.width * edgeRatio,
        );
        gallery.classList.toggle(
          "is-hover-right",
          x > rect.width * (1 - edgeRatio) && x <= rect.width,
        );
      };
      const clearEdgeHover = (): void => {
        gallery.classList.remove("is-hover-left", "is-hover-right");
      };

      viewport.addEventListener("pointermove", (event) => {
        if (event.pointerType === "mouse") setEdgeHover(event);
      });
      viewport.addEventListener("pointerleave", clearEdgeHover);

      let startX = 0;
      let startY = 0;
      let tracking = false;
      let swiped = false;

      viewport.addEventListener("pointerdown", (event) => {
        if (event.pointerType === "mouse") return;
        tracking = true;
        swiped = false;
        startX = event.clientX;
        startY = event.clientY;
      });

      viewport.addEventListener("pointerup", (event) => {
        if (!tracking) return;
        tracking = false;

        const dx = event.clientX - startX;
        const dy = event.clientY - startY;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
          swiped = true;
          move(dx < 0 ? 1 : -1);
          window.setTimeout(() => {
            swiped = false;
          }, 0);
        }
      });

      viewport.addEventListener("pointercancel", () => {
        tracking = false;
      });

      viewport.addEventListener(
        "click",
        (event) => {
          if (!swiped) return;
          event.preventDefault();
          event.stopPropagation();
          swiped = false;
        },
        true,
      );
    });
  </script>

  <script>
    // 收起菜单分组时，把该组表头带回顶部导航下方，避免页面停在展开内容的深处。
    (() => {
      const groups = [...document.querySelectorAll<HTMLDetailsElement>(".menu-acc")];
      if (!groups.length) return;

      const header = document.querySelector<HTMLElement>(".site-header");
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
      const gap = 10;

      // 菜单分组头吸顶时也要让开顶部横幅，不能藏在它下面
      const syncHeaderHeight = () => {
        if (!header) return;
        document.documentElement.style.setProperty(
          "--site-header-height",
          `${header.getBoundingClientRect().height}px`,
        );
      };
      syncHeaderHeight();
      window.addEventListener("resize", syncHeaderHeight);
      if (header && "ResizeObserver" in window) {
        new ResizeObserver(syncHeaderHeight).observe(header);
      }

      groups.forEach((group) => {
        group.addEventListener("toggle", () => {
          if (group.open) return;

          // 等折叠后的布局落定再看表头位置，避免被浏览器的滚动锚定拉回去
          requestAnimationFrame(() => {
            const headerHeight = header?.getBoundingClientRect().height ?? 0;
            const summary = group.querySelector<HTMLElement>("summary");
            const rect = summary?.getBoundingClientRect();

            // 表头已经完整落在横幅下方的屏幕内，就保持原位，不强制跳转
            if (
              rect &&
              rect.top >= headerHeight - 1 &&
              rect.bottom <= window.innerHeight + 1
            ) {
              return;
            }

            const top = group.getBoundingClientRect().top + window.scrollY - headerHeight - gap;
            window.scrollTo({
              top: Math.max(0, top),
              behavior: reduced.matches ? "auto" : "smooth",
            });
          });
        });
      });

      // 从搜索结果进来：展开对应分组，并把目标菜标出来。
      const targetMatch = /^#menu-(\d+)$/.exec(window.location.hash);
      if (targetMatch) {
        const targetGroup = document.getElementById(`menu-${targetMatch[1]}`);
        const dish = new URLSearchParams(window.location.search).get("dish");
        if (targetGroup instanceof HTMLDetailsElement) {
          targetGroup.open = true;
          if (dish) {
            const item = [...targetGroup.querySelectorAll<HTMLElement>("[data-menu-dish]")].find(
              (row) => row.dataset.menuDish === dish,
            );
            if (item) {
              item.classList.add("is-target");
              requestAnimationFrame(() => {
                const headerHeight = header?.getBoundingClientRect().height ?? 0;
                const groupHeadHeight =
                  targetGroup.querySelector<HTMLElement>("summary")?.getBoundingClientRect().height ?? 0;
                const top =
                  item.getBoundingClientRect().top + window.scrollY - headerHeight - groupHeadHeight - 12;
                window.scrollTo({
                  top: Math.max(0, top),
                  behavior: reduced.matches ? "auto" : "smooth",
                });
              });
            }
          }
        }
      }

      // 菜单里的说明按钮：点击在菜名附近展开自适应宽度的说明。
      const noteButtons = [...document.querySelectorAll<HTMLButtonElement>(".menu-item__note")];
      const canPopover = typeof HTMLElement.prototype.showPopover === "function";

      const placeNote = (button: HTMLButtonElement, pop: HTMLElement): void => {
        const margin = 12;
        const rect = button.getBoundingClientRect();
        const box = pop.getBoundingClientRect();
        let left = rect.left + rect.width / 2 - box.width / 2;
        if (left < margin) {
          left = Math.max(margin, Math.min(rect.left, window.innerWidth - margin - box.width));
        }
        if (left + box.width > window.innerWidth - margin) left = window.innerWidth - margin - box.width;
        let top = rect.bottom + 8;
        if (top + box.height > window.innerHeight - margin) top = rect.top - 8 - box.height;
        if (top < margin) top = margin;
        pop.style.left = `${left}px`;
        pop.style.top = `${top}px`;
      };

      noteButtons.forEach((button) => {
        const id = button.getAttribute("popovertarget");
        const pop = id ? document.getElementById(id) : null;
        if (!pop) return;

        if (canPopover) {
          pop.addEventListener("toggle", (event) => {
            const open = (event as Event & { newState?: string }).newState === "open";
            button.setAttribute("aria-expanded", String(open));
            if (open) requestAnimationFrame(() => placeNote(button, pop));
          });
          return;
        }

        // 老浏览器：退回 hidden 开关
        pop.hidden = true;
        button.addEventListener("click", (event) => {
          event.preventDefault();
          if (pop.hidden) {
            pop.hidden = false;
            button.setAttribute("aria-expanded", "true");
            requestAnimationFrame(() => placeNote(button, pop));
          } else {
            pop.hidden = true;
            button.setAttribute("aria-expanded", "false");
          }
        });
        document.addEventListener("click", (event) => {
          if (pop.hidden) return;
          if (button.contains(event.target as Node) || pop.contains(event.target as Node)) return;
          pop.hidden = true;
          button.setAttribute("aria-expanded", "false");
        });
        document.addEventListener("keydown", (event) => {
          if (event.key !== "Escape" || pop.hidden) return;
          pop.hidden = true;
          button.setAttribute("aria-expanded", "false");
        });
      });

      window.addEventListener("resize", () => {
        noteButtons.forEach((button) => {
          const id = button.getAttribute("popovertarget");
          const pop = id ? document.getElementById(id) : null;
          if (!pop) return;
          const open = canPopover ? pop.matches(":popover-open") : !pop.hidden;
          if (open) placeNote(button, pop);
        });
      });
    })();
  </script>
</BaseLayout>
