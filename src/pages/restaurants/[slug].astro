---
import { Image } from "astro:assets";
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { siteConfig } from "../../config/site";
import { withBase } from "../../lib/urls";
import { tagsOf } from "../../lib/shops";

export async function getStaticPaths() {
  const shops = await getCollection("restaurants");
  return shops.map((shop) => ({ params: { slug: shop.id }, props: { shop } }));
}

type Props = { shop: CollectionEntry<"restaurants"> };

const { shop } = Astro.props;
const {
  name,
  cuisine,
  dining,
  priceRange,
  distance,
  address,
  hours,
  summary,
  cover,
  gallery,
  dishes,
  menu,
  bills,
  order,
  sample,
} = shop.data;
const { Content } = await render(shop);

const hasBody = Boolean(shop.body?.trim());
const shopTags = tagsOf(shop);
const diningLabel =
  dining === "group" ? "多人聚餐" : dining === "single" ? "单人餐" : "聚餐 / 单人餐";

// 区块编号按实际渲染的区块算，缺哪个都不会跳号
const steps = [
  gallery.length > 0 && "环境",
  dishes.length > 0 && "推荐菜",
  (menu.length > 0 || order) && "菜单",
  hasBody && "备注",
].filter(Boolean) as string[];
const step = (label: string) => String(steps.indexOf(label) + 1).padStart(2, "0");

const priceValue = (price: string) => Number(price.replace(/[^\d.]/g, ""));
const menuGroups = menu.map((group) => {
  const values = group.items
    .map((item) => priceValue(item.price))
    .filter((value) => Number.isFinite(value) && value > 0);
  const min = values.length > 0 ? Math.min(...values) : null;
  const max = values.length > 0 ? Math.max(...values) : null;
  const range = min === null ? "" : min === max ? `¥${min}` : `¥${min}–${max}`;
  return { ...group, range };
});

const priceText = priceRange ?? (dining === "single" ? "丰俭由人" : "待补充");
const distanceText = distance ?? "待补充";

const siteUrl = Astro.site ?? new URL("https://asaberui1.github.io");
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;

const structuredData = sample
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "首页", item: new URL(import.meta.env.BASE_URL, siteUrl).href },
        {
          "@type": "ListItem",
          position: 2,
          name: "全部餐馆",
          item: new URL(`${import.meta.env.BASE_URL}restaurants/`, siteUrl).href,
        },
        { "@type": "ListItem", position: 3, name, item: pageUrl },
      ],
    }
  : {
      "@context": "https://schema.org",
      "@type": "Restaurant",
      name,
      description: summary,
      url: pageUrl,
      servesCuisine: cuisine,
      ...(priceRange ? { priceRange } : {}),
      address: { "@type": "PostalAddress", streetAddress: address, addressCountry: "CN" },
      ...(hours ? { openingHours: hours } : {}),
    };
---

<BaseLayout
  title={name}
  description={`${name}：${summary}（${cuisine} · ${diningLabel}${priceRange ? ` · 人均 ${priceRange}` : ""}）`}
  image={cover?.src ?? siteConfig.defaultImage}
  structuredData={structuredData}
>
  <Nav />

  <main id="main">
    <article class="shop">
      <header class:list={["shop-hero", { "shop-hero--plain": !cover }]}>
        {
          cover && (
            <>
              <Image
                class="media-fill"
                src={cover}
                alt={`${name} 的店内环境`}
                widths={[960, 1440, 2000]}
                sizes="100vw"
                loading="eager"
                decoding="sync"
              />
              <div class="overlay" style="background: var(--grad-vignette);"></div>
              <div class="overlay" style="background: var(--grad-shop-veil);"></div>
            </>
          )
        }

        <div class="shop-hero__content">
          <p class="label-eyebrow">{cuisine} · {diningLabel}{sample && " · 示例条目"}</p>
          <h1 class="shop-title display">{name}</h1>
          <p class="shop-summary">{summary}</p>
        </div>
      </header>

      <div class="container">
        <dl class="shop-meta">
          <div>
            <dt class="label-eyebrow">人均</dt>
            <dd>{priceText}</dd>
          </div>
          <div>
            <dt class="label-eyebrow">距离</dt>
            <dd>{distanceText}</dd>
          </div>
          <div>
            <dt class="label-eyebrow">营业</dt>
            <dd>{hours || "未记录"}</dd>
          </div>
          <div>
            <dt class="label-eyebrow">地址</dt>
            <dd>{address}</dd>
          </div>
        </dl>

        {
          bills.length > 0 && (
            <div class="bill">
              <p class="label-eyebrow">消费记录</p>
              <ul class="bill__list">
                {bills.map((record) => (
                  <li class="bill__line">
                    {record.label && <span class="bill__label">{record.label}</span>}
                    {record.people} · {record.items} · 共 <strong>{record.total}</strong>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        {
          gallery.length > 0 && (
            <section class="shop-section" aria-labelledby="gallery-title">
              <div class="shop-section__head">
                <p class="label-eyebrow">{step("环境")} — 环境</p>
                <h2 id="gallery-title" class="display">坐下来，先看看店</h2>
              </div>
              <div class="gallery">
                {gallery.map((photo) => (
                  <figure class="gallery__item">
                    <Image
                      src={photo.src}
                      alt={photo.alt}
                      widths={[480, 960]}
                      sizes="(min-width: 900px) 50vw, 100vw"
                      loading="lazy"
                    />
                  </figure>
                ))}
              </div>
            </section>
          )
        }

        {
          dishes.length > 0 && (
            <section class="shop-section" aria-labelledby="dishes-title">
              <div class="shop-section__head">
                <p class="label-eyebrow">{step("推荐菜")} — 推荐菜</p>
                <h2 id="dishes-title" class="display">回头还会再点的</h2>
              </div>
              <ol class="dish-list">
                {dishes.map((dish, index) => (
                  <li class:list={["dish", { "dish--with-media": Boolean(dish.image) }]}>
                    <span class="dish__no">{String(index + 1).padStart(2, "0")}</span>
                    <div class="dish__body">
                      <h3 class="dish__name">
                        {dish.name}
                        {dish.price && <span class="dish__price">{dish.price}</span>}
                      </h3>
                      {dish.note && <p class="dish__note">{dish.note}</p>}
                    </div>
                    {dish.image && (
                      <div class="dish__media">
                        <Image
                          src={dish.image}
                          alt={dish.name}
                          widths={[160, 320]}
                          sizes="120px"
                          loading="lazy"
                        />
                      </div>
                    )}
                  </li>
                ))}
              </ol>
            </section>
          )
        }

        {
          (menu.length > 0 || order) && (
            <section class="shop-section" aria-labelledby="menu-title">
              <div class="shop-section__head">
                <p class="label-eyebrow">{step("菜单")} — 菜单</p>
                <h2 id="menu-title" class="display">价目与点单</h2>
              </div>

              {menu.length > 0 && (
                <div class="menu-acc-list">
                  {menuGroups.map((group) => (
                    <details class="menu-acc">
                      <summary class="menu-acc__head">
                        <span class="menu-acc__title">{group.title}</span>
                        <span class="menu-acc__range">{group.range}</span>
                        <span class="menu-acc__count">{group.items.length} 道</span>
                        <span class="menu-acc__chev" aria-hidden="true">+</span>
                      </summary>
                      <div class="menu-acc__body">
                        {group.note && <p class="menu-acc__note">{group.note}</p>}
                        <ul class="menu-items">
                          {group.items.map((item) => (
                            <li class="menu-item">
                              <span class="menu-item__name">{item.name}</span>
                              <span class="menu-item__leader" aria-hidden="true"></span>
                              <span class="menu-item__price">{item.price}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                    </details>
                  ))}
                </div>
              )}

              {order && (
                <div class="order-block">
                  {order.qr && (
                    <Image
                      class="order-block__qr"
                      src={order.qr}
                      alt={`${name} 的扫码点餐二维码`}
                      widths={[240, 480]}
                      sizes="180px"
                      loading="lazy"
                    />
                  )}
                  <div class="order-block__copy">
                    <p class="label-eyebrow">扫码点餐</p>
                    <p>{order.note ?? "店内扫码点餐，菜单和价格以扫码页面为准。"}</p>
                    {order.tip && <p class="order-tip">{order.tip}</p>}
                    <p class="order-block__hint">
                      用微信或支付宝扫左边的码；这个页面是点餐小程序，电脑浏览器打不开。
                    </p>
                    {menu.length === 0 && <p class="menu-caveat">价目表待补充。</p>}
                  </div>
                </div>
              )}

              {menu.length > 0 && (
                <p class="menu-caveat">价格以最后一次到店为准，如有变动以店内为准。</p>
              )}
            </section>
          )
        }

        {
          hasBody && (
            <section class="shop-section" aria-labelledby="notes-title">
              <div class="shop-section__head">
                <p class="label-eyebrow">{step("备注")} — 备注</p>
                <h2 id="notes-title" class="display">去之前知道这些</h2>
              </div>
              <div class="prose">
                <Content />
              </div>
            </section>
          )
        }

        {
          shopTags.length > 0 && (
            <ul class="tag-row" aria-label="标签">
              {shopTags.map((tag) => (
                <li class="chip chip--muted">{tag}</li>
              ))}
            </ul>
          )
        }

        <nav class="shop-foot" aria-label="页面导航">
          <a class="text-link" href={withBase("/restaurants/")}>
            <span aria-hidden="true">&lt;-</span> 回到全部餐馆
          </a>
          <a
            class="text-link"
            href={`mailto:${siteConfig.contact.email}?subject=${encodeURIComponent(`关于「${name}」的补充`)}`}
          >
            补充信息或纠错 <span aria-hidden="true">-&gt;</span>
          </a>
        </nav>
      </div>
    </article>
  </main>

  <Footer />
</BaseLayout>
