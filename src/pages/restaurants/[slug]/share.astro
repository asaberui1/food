---
import { getImage } from "astro:assets";
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Nav from "../../../components/Nav.astro";
import Footer from "../../../components/Footer.astro";
import Icon from "../../../components/Icon.astro";
import { withBase } from "../../../lib/urls";
import { priceLabel } from "../../../lib/bills";

export async function getStaticPaths() {
  const shops = await getCollection("restaurants");
  return shops.map((shop) => ({ params: { slug: shop.id }, props: { shop } }));
}

const { shop } = Astro.props;
const { name, cuisine, address, cover, menu, dining } = shop.data;

// 分享卡要用一张足够大的底图
const coverUrl = cover ? (await getImage({ src: cover, width: 1200, format: "webp" })).src : null;

const priceText = priceLabel(shop);
const dishGroups = menu
  .map((group) => ({
    title: group.title,
    items: group.items.map((item) => ({ name: item.name, price: item.price })),
  }))
  .filter((group) => group.items.length > 0);

const payload = {
  name,
  cuisine,
  address,
  price: priceText,
  dining,
  cover: coverUrl,
  qr: `${import.meta.env.BASE_URL}qr/${shop.id}.png`,
};
---

<BaseLayout title={`分享「${name}」`} description={`把${name}做成一分享卡，挑几道菜就发出去。`}>
  <Nav />

  <main id="main">
    <section class="page-head">
      <div class="container page-head__inner">
        <p class="label-eyebrow">Share</p>
        <h1 class="page-title display">做一张分享卡</h1>
        <p class="page-lead">
          勾几道想推荐的菜，卡片会实时更新。手机上长按图片保存，电脑上右键保存或点下面的按钮下载。
        </p>
      </div>
    </section>

    <section class="section section--tight">
      <div class="container share-layout">
        <div class="share-preview">
          <img data-share-preview alt={`${name} 的分享卡预览`} width="1080" height="1440" />
          <a class="button-link" data-share-download download={`${name}-创智食单.jpg`}>
            下载分享卡 <Icon name="arrow-right" />
          </a>
        </div>

        <div class="share-panel">
          <div class="share-panel__meta">
            <p class="label-eyebrow">{cuisine} · {priceText}</p>
            <p class="share-panel__address">{address}</p>
          </div>

          <label class="share-pos">
            <span class="label-eyebrow">店招位置</span>
            <input type="range" min="0" max="100" value="50" data-share-pos />
            <span class="share-pos__hint">卡片用这张店招铺底，上下拖动可以调整露出哪一段</span>
          </label>

          {
            dishGroups.length > 0 ? (
              <>
                <p class="label-eyebrow">勾选要放进卡片的菜（最多 4 道）</p>
                <div class="share-dishes">
                  {dishGroups.map((group) => (
                    <details class="share-dish-group" open>
                      <summary>
                        {group.title}
                        <span class="share-dish-group__count">{group.items.length}</span>
                      </summary>
                      <div class="share-dish-list">
                        {group.items.map((item) => (
                          <label class="share-dish">
                            <input type="checkbox" value={item.name} data-price={item.price} />
                            <span class="share-dish__name">{item.name}</span>
                            <span class="share-dish__price">{item.price}</span>
                          </label>
                        ))}
                      </div>
                    </details>
                  ))}
                </div>
              </>
            ) : (
              <p class="search-hint">这家店还没有录入菜单，卡片会带上店名、地址和人均。</p>
            )
          }
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script type="application/json" id="share-data" set:html={JSON.stringify(payload)} />
  <script is:inline>
    (() => {
      const data = JSON.parse(document.getElementById("share-data").textContent);
      const canvas = document.createElement("canvas");
      canvas.width = 1080;
      canvas.height = 1440;
      const ctx = canvas.getContext("2d");
      const preview = document.querySelector("[data-share-preview]");
      const download = document.querySelector("[data-share-download]");
      const checkboxes = Array.from(document.querySelectorAll(".share-dish input[type=checkbox]"));
      const MAX = 4;

      const cover = new Image();
      const qr = new Image();
      let coverReady = false;
      let qrReady = false;
      if (data.cover) {
        cover.onload = () => {
          coverReady = true;
          draw();
        };
        cover.src = data.cover;
      }
      qr.onload = () => {
        qrReady = true;
        draw();
      };
      qr.src = data.qr;

      const fitted = (text, maxWidth) => {
        if (ctx.measureText(text).width <= maxWidth) return text;
        let out = text;
        while (out.length > 1 && ctx.measureText(`${out}…`).width > maxWidth) out = out.slice(0, -1);
        return `${out}…`;
      };

      let posY = 0.5;

      const draw = () => {
        ctx.clearRect(0, 0, 1080, 1440);

        // 店招铺满整张卡，纵向位置可调
        if (coverReady) {
          const scale = Math.max(1080 / cover.width, 1440 / cover.height);
          const w = cover.width * scale;
          const h = cover.height * scale;
          const offsetY = (1440 - h) * posY;
          ctx.drawImage(cover, (1080 - w) / 2, offsetY, w, h);
        } else {
          ctx.fillStyle = "#1d1813";
          ctx.fillRect(0, 0, 1080, 1440);
          const glow = ctx.createRadialGradient(540, 640, 40, 540, 640, 760);
          glow.addColorStop(0, "rgba(217,138,52,0.22)");
          glow.addColorStop(1, "rgba(23,19,15,0)");
          ctx.fillStyle = glow;
          ctx.fillRect(0, 0, 1080, 1440);
        }

        // 顶部压暗（标识）与底部压暗（文字）
        const top = ctx.createLinearGradient(0, 0, 0, 280);
        top.addColorStop(0, "rgba(13,10,7,0.88)");
        top.addColorStop(1, "rgba(13,10,7,0)");
        ctx.fillStyle = top;
        ctx.fillRect(0, 0, 1080, 280);

        const bottom = ctx.createLinearGradient(0, 760, 0, 1440);
        bottom.addColorStop(0, "rgba(13,10,7,0)");
        bottom.addColorStop(0.45, "rgba(13,10,7,0.66)");
        bottom.addColorStop(1, "rgba(11,8,6,0.98)");
        ctx.fillStyle = bottom;
        ctx.fillRect(0, 760, 1080, 680);

        // 顶部标识
        ctx.fillStyle = "#d98a34";
        ctx.fillRect(88, 96, 10, 10);
        ctx.fillStyle = "rgba(246,238,226,0.92)";
        ctx.font = '24px "PingFang SC", sans-serif';
        ctx.fillText("创智食单", 112, 108);
        ctx.fillStyle = "rgba(240,231,216,0.6)";
        ctx.font = '20px "PingFang SC", sans-serif';
        ctx.fillText("上海创智学院周边", 112, 138);

        // 文字投影
        ctx.shadowColor = "rgba(0,0,0,0.6)";
        ctx.shadowBlur = 20;
        ctx.shadowOffsetY = 2;

        // 店名
        ctx.fillStyle = "#f9f2e6";
        ctx.font = '500 66px "Noto Serif SC", serif';
        ctx.fillText(fitted(data.name, 700), 84, 1092);

        // 品类 + 人均
        ctx.fillStyle = "#f0b979";
        ctx.font = '28px "PingFang SC", sans-serif';
        const meta = [data.cuisine, data.price].filter((v) => v && v !== "待补充").join(" · ");
        ctx.fillText(fitted(meta, 600), 88, 1144);

        // 地址
        ctx.fillStyle = "rgba(240,231,216,0.74)";
        ctx.font = '26px "PingFang SC", sans-serif';
        ctx.fillText(fitted(data.address, 600), 88, 1186);

        // 选中的菜
        const picked = checkboxes
          .filter((box) => box.checked)
          .map((box) => ({ name: box.value, price: box.dataset.price || "" }));
        ctx.font = '28px "Noto Serif SC", serif';
        picked.slice(0, MAX).forEach((dish, index) => {
          ctx.fillStyle = "rgba(236,226,206,0.92)";
          ctx.fillText(fitted(`· ${dish.name}${dish.price ? "  " + dish.price : ""}`, 620), 88, 1250 + index * 44);
        });

        if (!picked.length) {
          ctx.fillStyle = "rgba(240,231,216,0.42)";
          ctx.font = '26px "PingFang SC", sans-serif';
          ctx.fillText("还没有选菜", 88, 1250);
        }

        ctx.shadowBlur = 0;
        ctx.shadowOffsetY = 0;

        // 二维码
        if (qrReady) {
          const size = 168;
          const pad = 12;
          const x = 1080 - 88 - size;
          const y = 1440 - 92 - size;
          ctx.fillStyle = "#fbf0dc";
          ctx.beginPath();
          ctx.roundRect(x - pad, y - pad, size + pad * 2, size + pad * 2, 14);
          ctx.fill();
          ctx.drawImage(qr, x, y, size, size);
        }

        const url = canvas.toDataURL("image/jpeg", 0.92);
        preview.src = url;
        download.href = url;
      };

      checkboxes.forEach((box) => {
        box.addEventListener("change", () => {
          const chosen = checkboxes.filter((item) => item.checked);
          if (chosen.length > MAX) {
            box.checked = false;
            return;
          }
          checkboxes.forEach((item) => {
            item.disabled = !item.checked && chosen.length >= MAX;
          });
          draw();
        });
      });

      const pos = document.querySelector("[data-share-pos]");
      if (pos) {
        posY = Number(pos.value) / 100;
        pos.addEventListener("input", () => {
          posY = Number(pos.value) / 100;
          draw();
        });
      }

      document.fonts.ready.then(draw);
    })();
  </script>
</BaseLayout>
