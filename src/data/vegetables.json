{
  "version": 1,
  "categoryTerms": [
    "时蔬",
    "蔬菜",
    "绿叶菜",
    "绿叶蔬菜",
    "时令蔬菜",
    "时令菜"
  ],
  "groups": [
    {
      "canonical": "生菜",
      "aliases": [
        "叶用莴苣",
        "鹅仔菜"
      ],
      "note": "上海最常见的生食/涮烫叶菜，蚝油生菜、生菜包肉都用它。"
    },
    {
      "canonical": "空心菜",
      "aliases": [
        "蕹菜",
        "通菜",
        "藤藤菜",
        "瓮菜",
        "竹叶菜"
      ],
      "note": "南方多叫通菜、蕹菜，四川叫藤藤菜；上海夏天常见蒜泥空心菜。"
    },
    {
      "canonical": "米苋",
      "aliases": [
        "苋菜",
        "红苋菜",
        "白苋菜"
      ],
      "note": "上海叫米苋，外地多叫苋菜；红苋菜炒出来汤汁是紫红色。"
    },
    {
      "canonical": "鸡毛菜",
      "aliases": [
        "小青菜",
        "鸡毛青菜"
      ],
      "note": "青菜的幼苗，上海人叫鸡毛菜，做汤、清炒都嫩。"
    },
    {
      "canonical": "上海青",
      "aliases": [
        "青菜",
        "小白菜",
        "瓢儿白",
        "青江菜",
        "小棠菜"
      ],
      "note": "上海叫青菜/上海青，四川叫瓢儿白，广东叫小棠菜；矮脚青菜更糯。"
    },
    {
      "canonical": "草头",
      "aliases": [
        "苜蓿",
        "金花菜",
        "秧草",
        "三叶菜"
      ],
      "note": "上海叫草头，江苏叫秧草/金花菜；酒香草头、草头圈子是本地做法。"
    },
    {
      "canonical": "马兰头",
      "aliases": [
        "马兰",
        "马兰菜",
        "红梗菜"
      ],
      "note": "上海春天常吃马兰头拌香干，外地也有叫马兰菜的。"
    },
    {
      "canonical": "茼蒿",
      "aliases": [
        "蓬蒿",
        "蒿菜",
        "皇帝菜"
      ],
      "note": "上海叫蓬蒿/茼蒿，涮锅和清炒都常见。"
    },
    {
      "canonical": "菠菜",
      "aliases": [
        "赤根菜",
        "波斯草"
      ],
      "note": "上海常见菠菜猪肝汤、清炒菠菜。"
    },
    {
      "canonical": "油麦菜",
      "aliases": [
        "莜麦菜",
        "油荬菜"
      ],
      "note": "叶用莴苣的一种，上海菜场和火锅店都常见。"
    },
    {
      "canonical": "菜心",
      "aliases": [
        "菜薹",
        "广东菜心"
      ],
      "note": "广东菜心，白灼或蒜蓉最常见。"
    },
    {
      "canonical": "芥蓝",
      "aliases": [
        "芥兰"
      ],
      "note": "广东叫芥兰，白灼芥蓝、蚝油芥蓝都常见。"
    },
    {
      "canonical": "豆苗",
      "aliases": [
        "豌豆苗",
        "豌豆尖",
        "豌豆颠"
      ],
      "note": "上海叫豆苗，四川叫豌豆尖；清炒或做汤都嫩。"
    },
    {
      "canonical": "塌菜",
      "aliases": [
        "乌塌菜",
        "塔菜",
        "塌棵菜"
      ],
      "note": "上海冬天常见，打过霜之后更甜，常和冬笋一起炒。"
    },
    {
      "canonical": "荠菜",
      "aliases": [
        "地菜",
        "荠荠菜",
        "护生草"
      ],
      "note": "上海人春天包荠菜肉馄饨，外地也有叫地菜的。"
    },
    {
      "canonical": "水芹",
      "aliases": [
        "水芹菜",
        "野芹菜"
      ],
      "note": "水生芹菜，上海本帮菜里常和香干一起炒。"
    },
    {
      "canonical": "枸杞头",
      "aliases": [
        "枸杞芽",
        "枸杞菜"
      ],
      "note": "枸杞的嫩芽，上海春天常清炒，微苦回甘。"
    },
    {
      "canonical": "香椿",
      "aliases": [
        "香椿芽",
        "椿芽"
      ],
      "note": "春天限定，香椿炒蛋、香椿拌豆腐最常见。"
    },
    {
      "canonical": "西洋菜",
      "aliases": [
        "豆瓣菜",
        "水田芥"
      ],
      "note": "广东叫西洋菜，上海部分菜场也有，常用来煲汤。"
    },
    {
      "canonical": "紫角叶",
      "aliases": [
        "落葵",
        "木耳菜"
      ],
      "note": "上海夏天常见，叶子黏滑，蒜蓉清炒最多。"
    },
    {
      "canonical": "韭菜",
      "aliases": [
        "起阳草"
      ],
      "note": "上海常见韭菜炒蛋、韭菜炒银芽。"
    },
    {
      "canonical": "芹菜",
      "aliases": [
        "旱芹",
        "药芹"
      ],
      "note": "上海菜场常见药芹，香芹炒干丝、芹菜肉丝都常见。"
    }
  ]
}
