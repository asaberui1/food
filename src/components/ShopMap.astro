---
/**
 * 学院周边餐馆分布图。
 *
 * 底图是 scripts/map-render.py 从 OSM 数据离线渲染出来的矢量图
 * （src/assets/map/neighbourhood.svg），不请求任何瓦片服务，
 * 配色和站点一致，红点本身就是指向各店详情页的链接。
 *
 * 新增门店后要重跑脚本补点，否则这家店不会出现在图上——
 * 构建时会打印警告提醒。
 */
import { getCollection } from "astro:content";
import rawMap from "../assets/map/neighbourhood.svg?raw";
import { withBase } from "../lib/urls";

// 脚本里用 {{base}} 占位，部署到 /food/ 下时才替换成真实前缀
const svg = rawMap.replaceAll("{{base}}", withBase("/"));

const pinned = new Set([...rawMap.matchAll(/data-map-slug="([^"]+)"/g)].map((match) => match[1]));
const missing = (await getCollection("restaurants"))
  .filter((shop) => !pinned.has(shop.id))
  .map((shop) => shop.data.name);

if (missing.length > 0) {
  console.warn(
    `[ShopMap] 这些店还没标在地图上：${missing.join("、")}。补好坐标后重跑 python3 scripts/map-render.py`,
  );
}
---

<figure class="shop-map">
  <div class="shop-map__frame">
    <div class="shop-map__scroll" data-map-scroll>
      <Fragment set:html={svg} />
    </div>
  </div>
  <figcaption class="shop-map__caption">
    <span class="shop-map__key">
      <span class="shop-map__key-star" aria-hidden="true"></span>上海创智学院
    </span>
    <span class="shop-map__key">
      <span class="shop-map__key-dot" aria-hidden="true"></span>收录的餐馆，点红点进店
    </span>
    <span class="shop-map__hint">手机上可以左右拖动</span>
    <span class="shop-map__credit">
      底图 © <a href="https://www.openstreetmap.org/copyright" rel="noopener">OpenStreetMap</a> 贡献者
    </span>
  </figcaption>
</figure>

<script is:inline>
  // 窄屏下图要横向滚动，默认停在最左边会把学院挤出屏幕，先居中到学院那颗星
  (() => {
    const box = document.querySelector("[data-map-scroll]");
    if (!box || box.scrollWidth <= box.clientWidth + 1) return;
    const star = box.querySelector(".map-campus circle");
    const svg = box.querySelector("svg");
    if (!star || !svg) return;
    const scale = box.scrollWidth / svg.viewBox.baseVal.width;
    box.scrollLeft = Number(star.getAttribute("cx")) * scale - box.clientWidth / 2;
  })();
</script>
