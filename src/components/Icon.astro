---
type IconName =
  | "arrow-right"
  | "arrow-left"
  | "refresh"
  | "chevron"
  | "search"
  | "plus"
  | "star"
  | "share"
  | "list"
  | "gear"
  | "download"
  | "arrow-up"
  | "photo"
  | "info";

type Props = {
  name: IconName;
  size?: number;
  class?: string;
};

const { name, size = 16, class: className } = Astro.props;

const paths: Record<IconName, string> = {
  "arrow-right": '<path d="M3.5 10h12.2"/><path d="m11 5.2 4.8 4.8L11 14.8"/>',
  "arrow-left": '<path d="M16.5 10H4.3"/><path d="M9 5.2 4.2 10 9 14.8"/>',
  "arrow-up": '<path d="M10 16.2V4.4"/><path d="M5.2 9.2 10 4.4l4.8 4.8"/>',
  refresh:
    '<path d="M16.2 10a6.2 6.2 0 1 1-2.1-4.7"/><path d="M16.4 3.6v3.6H12.8"/>',
  chevron: '<path d="m5.4 7.8 4.6 4.6 4.6-4.6"/>',
  search: '<circle cx="8.8" cy="8.8" r="5.4"/><path d="m12.9 12.9 3.6 3.6"/>',
  plus: '<path d="M10 4.6v10.8M4.6 10h10.8"/>',
  star: '<path d="m10 3.3 2.1 4.2 4.6.7-3.3 3.3.8 4.6-4.2-2.2-4.2 2.2.8-4.6L3.3 8.2l4.6-.7z"/>',
  list: '<path d="M4 6h12M4 10h12M4 14h8"/>',
  gear: '<circle cx="10" cy="10" r="2.6"/><path d="M10 3.4v1.5M10 15.1v1.5M16.6 10h-1.5M4.9 10H3.4M14.7 5.3l-1.1 1.1M6.4 13.6l-1.1 1.1M14.7 14.7l-1.1-1.1M6.4 6.4 5.3 5.3"/>',
  download: '<path d="M10 3.6v8.8"/><path d="m6.4 9.2 3.6 3.6 3.6-3.6"/><path d="M4.6 15.6h10.8"/>',
  photo:
    '<rect x="3" y="4.6" width="14" height="10.8" rx="1.6"/><circle cx="7.4" cy="8.4" r="1.3"/><path d="m4.4 14.2 3.4-3.2 2.5 2.3 2.6-2.9 2.7 3"/>',
  info: '<circle cx="10" cy="10" r="7"/><text x="10" y="14.8" text-anchor="middle" font-family="Info Georgia" font-style="italic" font-weight="600" font-size="12.5" fill="currentColor" stroke="none">ı</text><svg x="-0.7" y="0" width="20" height="8.2" viewBox="0 0 20 8.2" overflow="hidden"><text x="10" y="14.8" text-anchor="middle" font-family="Info Georgia" font-style="italic" font-weight="600" font-size="12.5" fill="currentColor" stroke="none">i</text></svg>',
  share: '<path d="M10 12.4V3.4"/><path d="m6.5 6.7 3.5-3.3 3.5 3.3"/><path d="M4.6 11.2v4.2c0 .6.5 1.1 1.1 1.1h8.6c.6 0 1.1-.5 1.1-1.1v-4.2"/>',
};
---

<svg
  class:list={["icon", className]}
  width={size}
  height={size}
  viewBox="0 0 20 20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths[name]}
/>
