---
import { getImage } from "astro:assets";
import Icon from "./Icon.astro";
import { priceLabel } from "../lib/bills";

type MenuGroup = { title: string; items: { name: string; price: string }[] };

type Props = {
  shop: any;
  menu: MenuGroup[];
  qr: string;
  /** 触发按钮的样式与文字，默认是页面上的主按钮 */
  triggerClass?: string;
  triggerLabel?: string;
  triggerIcon?: "share" | "gear";
};

const {
  shop,
  menu,
  qr,
  triggerClass = "button-link",
  triggerLabel = "自定义分享卡",
  triggerIcon = "share",
} = Astro.props;
const { name, cuisine, address, cover, dishes } = shop.data;

const coverUrl = cover ? (await getImage({ src: cover, width: 1400, quality: 88, format: "webp" })).src : null;
const defaultDishes = (dishes ?? []).slice(0, 3).map((dish: any) => dish.name);

const payload = {
  name,
  cuisine,
  address,
  price: priceLabel(shop),
  cover: coverUrl,
  qr,
  dishes: defaultDishes,
  menu,
};
---

<a
  class={triggerClass}
  href={`${import.meta.env.BASE_URL}share/${shop.id}.jpg`}
  target="_blank"
  rel="noopener"
  data-studio-open
>
  <Icon name={triggerIcon} size={15} /> {triggerLabel}
</a>

<dialog class="studio" data-studio tabindex="-1">
  <div class="studio__card">
    <canvas class="studio__canvas" width="1080" height="1440" data-studio-canvas></canvas>

    <div class="studio__dpad" aria-label="调整底图位置">
      <button type="button" data-dir="up" aria-label="向上"><Icon name="chevron" size={16} /></button>
      <button type="button" data-dir="left" aria-label="向左"><Icon name="chevron" size={16} /></button>
      <button type="button" data-dir="right" aria-label="向右"><Icon name="chevron" size={16} /></button>
      <button type="button" data-dir="down" aria-label="向下"><Icon name="chevron" size={16} /></button>
      <button type="button" data-zoom aria-label="缩放底图"><Icon name="search" size={14} /></button>
    </div>

    <div class="studio__slots" data-studio-slots></div>

    <div class="studio__result" data-studio-result hidden>
      <img data-studio-result-img alt="分享卡成品" />
    </div>
  </div>

  <div class="studio__bar">
    <button type="button" class="button-link" data-studio-generate>生成分享卡</button>
    <a class="button-link" data-studio-download download hidden>下载</a>
    <button type="button" class="button-link button-link--outline" data-studio-edit hidden>重新调整</button>
    <span class="studio__hint" data-studio-hint>拖动挪底图，铅笔换菜</span>
    <button type="button" class="studio__close" data-studio-close>关闭</button>
  </div>

  <div class="studio__picker" data-studio-picker hidden>
    <div class="studio__picker-head">
      <p class="label-eyebrow">换一道菜（最多 3 道）</p>
      <button type="button" class="studio__picker-close" data-picker-close>完成</button>
    </div>
    <div class="studio__picker-body" data-picker-body></div>
  </div>
</dialog>

<script type="application/json" id="studio-data" set:html={JSON.stringify(payload)} />

<script is:inline>
  (() => {
    const dialog = document.querySelector("[data-studio]");
    const indexNode = document.getElementById("studio-data");
    if (!dialog || !indexNode) return;

    const data = JSON.parse(indexNode.textContent);
    const canvas = dialog.querySelector("[data-studio-canvas]");
    const ctx = canvas.getContext("2d");
    const card = dialog.querySelector(".studio__card");
    const slotsRoot = dialog.querySelector("[data-studio-slots]");
    const picker = dialog.querySelector("[data-studio-picker]");
    const pickerBody = dialog.querySelector("[data-picker-body]");
    const result = dialog.querySelector("[data-studio-result]");
    const resultImg = dialog.querySelector("[data-studio-result-img]");
    const download = dialog.querySelector("[data-studio-download]");
    const MAX = 3;

    let offsetX = 0.5;
    let offsetY = 0.45;
    let zoom = 1;
    const ZOOMS = [1, 1.25, 1.5];
    let zoomIndex = 0;
    let selected = [...data.dishes];
    let showDishes = false;

    const cover = new Image();
    let coverReady = false;
    const qr = new Image();
    let qrReady = false;
    if (data.cover) {
      cover.onload = () => {
        coverReady = true;
        draw();
      };
      cover.src = data.cover;
    }
    qr.onload = () => {
      qrReady = true;
      draw();
    };
    qr.src = data.qr;

    const fitted = (text, maxWidth) => {
      if (ctx.measureText(text).width <= maxWidth) return text;
      let out = text;
      while (out.length > 1 && ctx.measureText(`${out}…`).width > maxWidth) out = out.slice(0, -1);
      return `${out}…`;
    };

    const draw = () => {
      ctx.clearRect(0, 0, 1080, 1440);

      if (coverReady) {
        const scale = Math.max(1080 / cover.width, 1440 / cover.height) * zoom;
        const w = cover.width * scale;
        const h = cover.height * scale;
        ctx.drawImage(cover, -(w - 1080) * offsetX, -(h - 1440) * offsetY, w, h);
      } else {
        ctx.fillStyle = "#1d1813";
        ctx.fillRect(0, 0, 1080, 1440);
      }

      const bottom = ctx.createLinearGradient(0, 700, 0, 1440);
      bottom.addColorStop(0, "rgba(13,10,7,0)");
      bottom.addColorStop(0.38, "rgba(13,10,7,0.72)");
      bottom.addColorStop(1, "rgba(11,8,6,0.98)");
      ctx.fillStyle = bottom;
      ctx.fillRect(0, 700, 1080, 740);

      ctx.shadowColor = "rgba(0,0,0,0.6)";
      ctx.shadowBlur = 22;
      ctx.shadowOffsetY = 2;

      ctx.fillStyle = "#f9f2e6";
      let nameSize = 84;
      do {
        ctx.font = `500 ${nameSize}px "Noto Serif SC", serif`;
        if (ctx.measureText(data.name).width <= 912) break;
        nameSize -= 2;
      } while (nameSize > 44);
      ctx.fillText(fitted(data.name, 912), 84, 1046);

      ctx.fillStyle = "#f0b979";
      ctx.font = '34px "PingFang SC", sans-serif';
      const meta = [data.cuisine, data.price].filter((v) => v && v !== "待补充").join(" · ");
      ctx.fillText(fitted(meta, 640), 88, 1112);

      ctx.fillStyle = "rgba(240,231,216,0.76)";
      ctx.font = '32px "PingFang SC", sans-serif';
      ctx.fillText(fitted(data.address, 640), 88, 1164);

      if (showDishes) {
        selected.slice(0, MAX).forEach((dish, index) => {
          const price = findPrice(dish);
          const y = 1226 + index * 54;
          ctx.fillStyle = "rgba(236,226,206,0.94)";
          ctx.font = '34px "Noto Serif SC", serif';
          const dishText = fitted(`· ${dish}`, 560);
          ctx.fillText(dishText, 88, y);
          if (price) {
            const priceFont = '31px Helvetica, Arial, sans-serif';
            const start = 88 + ctx.measureText(dishText).width + 12;
            ctx.font = priceFont;
            const end = 700 - ctx.measureText(price).width - 20;
            ctx.fillStyle = "rgba(236,226,206,0.5)";
            for (let x = end; x >= start; x -= 16) {
              ctx.beginPath();
              ctx.arc(x, y - 11, 2.2, 0, Math.PI * 2);
              ctx.fill();
            }
            ctx.fillStyle = "rgba(236,226,206,0.94)";
            ctx.textAlign = "right";
            ctx.fillText(price, 700, y);
            ctx.textAlign = "left";
          }
        });
      }

      ctx.shadowBlur = 0;
      ctx.shadowOffsetY = 0;

      const qrSize = 168;
      const pad = 12;
      const qrX = 1080 - 88 - qrSize;
      const qrY = 1440 - 120 - qrSize;
      if (qrReady) {
        ctx.fillStyle = "#fbf0dc";
        ctx.beginPath();
        ctx.roundRect(qrX - pad, qrY - pad, qrSize + pad * 2, qrSize + pad * 2, 14);
        ctx.fill();
        ctx.drawImage(qr, qrX, qrY, qrSize, qrSize);
      }

      ctx.fillStyle = "#f9f2e6";
      ctx.font = '600 30px "Noto Serif SC", serif';
      ctx.textAlign = "right";
      ctx.fillText("创智食单", 1080 - 88, qrY + qrSize + 46);
      ctx.textAlign = "left";
    };

    const findPrice = (name) => {
      for (const group of data.menu || []) {
        const hit = group.items.find((item) => item.name === name);
        if (hit) return hit.price;
      }
      const base = name.replace(/（.*$/, "");
      const bases = [base, base.replaceAll("鳜", "桂"), base.replaceAll("桂", "鳜")];
      for (const group of data.menu || []) {
        const hit = group.items.find((item) => bases.some((candidate) => item.name.startsWith(candidate)));
        if (hit) return hit.price;
      }
      return "";
    };

    // 卡片内的浮层按卡片实际宽度换算
    const syncScale = () => {
      const width = card.clientWidth;
      card.style.setProperty("--s", `${width / 1080}`);
    };

    const renderSlots = () => {
      slotsRoot.replaceChildren();
      for (let index = 0; index < MAX; index += 1) {
        const name = selected[index];
        const slot = document.createElement("div");
        slot.className = "studio__slot";

        const label = document.createElement("span");
        label.className = "studio__slot-name";
        label.textContent = name || "选一道菜";
        slot.append(label);

        const tool = document.createElement("button");
        tool.type = "button";
        tool.className = "studio__slot-tool";
        tool.setAttribute("aria-label", name ? "更换这道菜" : "选择一道菜");
        tool.innerHTML = '<svg viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m13.2 3.6 3.2 3.2L7.2 16 3 17l1-4.2z"/><path d="m11.7 5.1 3.2 3.2"/></svg>';
        tool.addEventListener("click", () => openPicker(index));
        slot.append(tool);

        if (!name) slot.classList.add("is-empty");
        slotsRoot.append(slot);
      }
    };

    const openPicker = (slotIndex) => {
      picker.hidden = false;
      picker.dataset.slot = String(slotIndex);
      pickerBody.replaceChildren();

      if (!data.menu || !data.menu.length) {
        const empty = document.createElement("p");
        empty.className = "studio__empty";
        empty.textContent = "这家店还没有录入菜单，暂时没得换。";
        pickerBody.append(empty);
        return;
      }

      data.menu.forEach((group) => {
        const details = document.createElement("details");
        details.className = "studio__group";

        const summary = document.createElement("summary");
        summary.className = "studio__group-head";

        const title = document.createElement("span");
        title.className = "label-eyebrow studio__group-title";
        title.textContent = group.title;

        const count = document.createElement("span");
        count.className = "studio__group-count";
        count.textContent = `${group.items.length} 道`;

        const chev = document.createElement("span");
        chev.className = "studio__group-chev";
        chev.textContent = "+";
        chev.setAttribute("aria-hidden", "true");

        summary.append(title, count, chev);
        details.append(summary);

        const list = document.createElement("div");
        list.className = "studio__group-list";
        group.items.forEach((item) => {
          const button = document.createElement("button");
          button.type = "button";
          button.className = "studio__pick";
          const selectedIndex = selected.indexOf(item.name);
          if (selectedIndex >= 0) button.classList.add("is-on");
          if (selectedIndex >= 0 && selectedIndex !== slotIndex) {
            button.classList.add("is-taken");
            button.disabled = true;
          }
          button.innerHTML = `<span class="studio__pick-name">${item.name}</span><span class="studio__pick-leader" aria-hidden="true"></span><span class="studio__pick-price">${item.price}</span>`;
          button.addEventListener("click", () => {
            // 点当前槽位已选的菜：直接完成；点其他槽位已选的菜：不允许（按钮已 disabled）
            if (selected[slotIndex] === item.name) {
              closePicker();
              return;
            }
            if (!selected[slotIndex] && selected.length >= MAX) return;
            selected[slotIndex] = item.name;
            selected = selected.filter(Boolean).slice(0, MAX);
            closePicker();
            renderSlots();
            draw();
          });
          list.append(button);
        });

        details.append(list);
        pickerBody.append(details);
      });
    };

    const closePicker = () => {
      picker.hidden = true;
    };

    // 方向键
    dialog.querySelectorAll("[data-dir]").forEach((button) => {
      button.addEventListener("click", () => {
        const step = 0.06;
        const dir = button.dataset.dir;
        if (dir === "up") offsetY = Math.max(0, offsetY - step);
        if (dir === "down") offsetY = Math.min(1, offsetY + step);
        if (dir === "left") offsetX = Math.max(0, offsetX - step);
        if (dir === "right") offsetX = Math.min(1, offsetX + step);
        draw();
      });
    });

    const zoomButton = dialog.querySelector("[data-zoom]");

    // 拖动 / 双指缩放底图
    const clamp01 = (value) => Math.max(0, Math.min(1, value));
    const pointers = new Map();
    let dragging = false;
    let lastX = 0;
    let lastY = 0;
    let pinchStart = 0;
    let pinchZoom = 1;

    const coverSize = () => {
      if (!coverReady) return null;
      const scale = Math.max(1080 / cover.width, 1440 / cover.height) * zoom;
      return { w: cover.width * scale, h: cover.height * scale };
    };

    card.addEventListener("pointerdown", (event) => {
      if (event.target.closest("button")) return;
      pointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
      card.setPointerCapture(event.pointerId);
      if (pointers.size === 2) {
        const [a, b] = [...pointers.values()];
        pinchStart = Math.hypot(a.x - b.x, a.y - b.y);
        pinchZoom = zoom;
        dragging = false;
        return;
      }
      dragging = true;
      lastX = event.clientX;
      lastY = event.clientY;
      card.classList.add("is-dragging");
    });

    card.addEventListener("pointermove", (event) => {
      if (!pointers.has(event.pointerId)) return;
      pointers.set(event.pointerId, { x: event.clientX, y: event.clientY });

      if (pointers.size === 2) {
        const [a, b] = [...pointers.values()];
        const dist = Math.hypot(a.x - b.x, a.y - b.y);
        if (pinchStart > 0 && dist > 0) {
          zoom = Math.max(1, Math.min(2.4, pinchZoom * (dist / pinchStart)));
          zoomIndex = ZOOMS.findIndex((z) => Math.abs(z - zoom) < 0.02);
          zoomButton.setAttribute("aria-label", `缩放底图，当前 ${Math.round(zoom * 100)}%`);
          zoomButton.title = `缩放：${Math.round(zoom * 100)}%`;
          draw();
        }
        return;
      }

      if (!dragging) return;
      const dx = event.clientX - lastX;
      const dy = event.clientY - lastY;
      lastX = event.clientX;
      lastY = event.clientY;

      const size = coverSize();
      if (!size) return;
      const ratio = 1080 / (card.clientWidth || 1080);
      offsetX = clamp01(offsetX - (dx * ratio) / Math.max(1, size.w - 1080));
      offsetY = clamp01(offsetY - (dy * ratio) / Math.max(1, size.h - 1440));
      draw();
    });

    const endPointer = (event) => {
      pointers.delete(event.pointerId);
      if (pointers.size < 2) pinchStart = 0;
      if (pointers.size === 0) {
        dragging = false;
        card.classList.remove("is-dragging");
      }
      if (card.hasPointerCapture(event.pointerId)) card.releasePointerCapture(event.pointerId);
    };
    card.addEventListener("pointerup", endPointer);
    card.addEventListener("pointercancel", endPointer);

    const applyZoom = () => {
      zoom = ZOOMS[zoomIndex];
      zoomButton.setAttribute("aria-label", `缩放底图，当前 ${Math.round(zoom * 100)}%`);
      zoomButton.title = `缩放：${Math.round(zoom * 100)}%`;
      draw();
    };
    zoomButton.addEventListener("click", () => {
      zoomIndex = (zoomIndex + 1) % ZOOMS.length;
      applyZoom();
    });

    // 滚轮缩放底图；阻止滚到弹窗后面的页面。换菜列表本身要能滚，放行。
    document.addEventListener(
      "wheel",
      (event) => {
        if (!dialog.open) return;
        const target = event.target instanceof Element ? event.target : null;
        if (target?.closest("[data-picker-body]")) return;
        event.preventDefault();
        if (!target?.closest(".studio__card")) return;
        const factor = event.deltaY < 0 ? 1.1 : 1 / 1.1;
        zoom = Math.max(1, Math.min(2.4, Math.round(zoom * factor * 100) / 100));
        zoomIndex = ZOOMS.reduce(
          (best, value, index) =>
            Math.abs(value - zoom) < Math.abs(ZOOMS[best] - zoom) ? index : best,
          0,
        );
        zoomButton.setAttribute("aria-label", `缩放底图，当前 ${Math.round(zoom * 100)}%`);
        zoomButton.title = `缩放：${Math.round(zoom * 100)}%`;
        draw();
      },
      { passive: false },
    );

    // 生成
    const generate = dialog.querySelector("[data-studio-generate]");
    const edit = dialog.querySelector("[data-studio-edit]");
    const hint = dialog.querySelector("[data-studio-hint]");

    generate.addEventListener("click", () => {
      showDishes = true;
      draw();
      const url = canvas.toDataURL("image/jpeg", 0.92);
      resultImg.src = url;
      download.href = url;
      result.hidden = false;
      card.classList.add("is-result");
      generate.hidden = true;
      edit.hidden = false;
      download.hidden = false;
      if (hint) hint.hidden = true;
      showDishes = false;
    });

    edit.addEventListener("click", () => {
      result.hidden = true;
      card.classList.remove("is-result");
      generate.hidden = false;
      edit.hidden = true;
      download.hidden = true;
      if (hint) hint.hidden = false;
      draw();
    });

    dialog.querySelector("[data-picker-close]").addEventListener("click", closePicker);
    dialog.querySelector("[data-studio-close]").addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => {
      // 点卡片外的遮罩关闭；点卡片内部不关
      if (event.target === dialog) dialog.close();
    });

    const open = async () => {
      // 每次打开都从默认推荐菜开始，不沿用上一次的自定义
      selected = [...data.dishes];
      showDishes = false;
      picker.hidden = true;
      result.hidden = true;
      card.classList.remove("is-result");
      generate.hidden = false;
      edit.hidden = true;
      download.hidden = true;
      offsetX = 0.5;
      offsetY = 0.45;
      zoom = 1;
      zoomIndex = 0;
      zoomButton.setAttribute("aria-label", "缩放底图，当前 100%");
      zoomButton.title = "缩放：100%";

      renderSlots();
      dialog.showModal();
      dialog.focus();
      syncScale();
      draw();

      // 字体按需加载，首帧可能还没到位，加载完再画一次
      const sample = [data.name, data.cuisine, data.address, ...selected].join("");
      try {
        await Promise.all([
          document.fonts.load('500 84px "Noto Serif SC"', sample),
          document.fonts.load('34px "Noto Serif SC"', sample),
          document.fonts.load('34px "PingFang SC"', sample),
        ]);
      } catch {}
      draw();
    };

    document.querySelectorAll("[data-studio-open]").forEach((button) => {
      button.addEventListener("click", (event) => {
        // 触发器本身是 <a href="分享卡大图">，JS 可用时拦掉跳转，直接开自定义弹窗
        event.preventDefault();
        open();
      });
    });

    window.addEventListener("resize", () => {
      if (dialog.open) syncScale();
    });

    document.fonts.ready.then(() => {
      if (dialog.open) draw();
    });
  })();
</script>
