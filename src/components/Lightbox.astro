---
/** 点击任意带 data-lightbox 的图片即可放大查看 */
---

<dialog class="lightbox" data-lightbox-dialog>
  <button type="button" class="lightbox__close" data-lightbox-close aria-label="关闭大图">关闭</button>
  <img data-lightbox-img alt="" />
</dialog>

<script is:inline>
  (() => {
    const dialog = document.querySelector("[data-lightbox-dialog]");
    const image = dialog?.querySelector("[data-lightbox-img]");
    if (!dialog || !image) return;

    const close = () => {
      if (typeof dialog.close === "function") dialog.close();
      else dialog.removeAttribute("open");
    };

    // 取 srcset 里最大的一张，避免点开还是缩略图
    const largestSource = (img) => {
      const srcset = img.getAttribute("srcset");
      if (!srcset) return img.currentSrc || img.src;
      const entries = srcset
        .split(",")
        .map((part) => part.trim().split(/\s+/))
        .map(([url, width]) => ({ url, width: Number.parseInt(width, 10) || 0 }))
        .sort((a, b) => b.width - a.width);
      return entries[0]?.url || img.src;
    };

    document.querySelectorAll("[data-lightbox]").forEach((img) => {
      img.addEventListener("click", () => {
        image.src = largestSource(img);
        image.alt = img.alt || "";
        if (typeof dialog.showModal === "function") dialog.showModal();
        else dialog.setAttribute("open", "");
      });
    });

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) close();
    });
    dialog.querySelector("[data-lightbox-close]").addEventListener("click", close);
  })();
</script>
