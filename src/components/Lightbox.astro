---
/** 点击任意带 data-lightbox 的图片即可放大查看 */
---

<dialog class="lightbox" data-lightbox-dialog>
  <button type="button" class="lightbox__close" data-lightbox-close aria-label="关闭大图">关闭</button>
  <img data-lightbox-img alt="" />
  <p class="lightbox__status" data-lightbox-status hidden>正在加载大图…</p>
</dialog>

<script is:inline>
  (() => {
    const dialog = document.querySelector("[data-lightbox-dialog]");
    const image = dialog?.querySelector("[data-lightbox-img]");
    if (!dialog || !image) return;

    const close = () => {
      if (typeof dialog.close === "function") dialog.close();
      else dialog.removeAttribute("open");
    };

    // 取 srcset 里最大的一张，避免点开还是缩略图
    const largestSource = (img) => {
      const srcset = img.getAttribute("srcset");
      if (!srcset) return img.currentSrc || img.src;
      const entries = srcset
        .split(",")
        .map((part) => part.trim().split(/\s+/))
        .map(([url, width]) => ({ url, width: Number.parseInt(width, 10) || 0 }))
        .sort((a, b) => b.width - a.width);
      return entries[0]?.url || img.src;
    };

    const status = dialog.querySelector("[data-lightbox-status]");

    const openDialog = () => {
      if (typeof dialog.showModal === "function") dialog.showModal();
      else dialog.setAttribute("open", "");
    };

    // 触发大图的可能是图片，也可能是菜单里的一行菜名（没有缩略图）
    document.querySelectorAll("[data-lightbox]").forEach((trigger) => {
      trigger.addEventListener("click", (event) => {
        // 外面那层是 <a>，有 JS 时别让它跳走
        event.preventDefault();
        const isImg = trigger instanceof HTMLImageElement;
        const thumb = isImg ? trigger.currentSrc || trigger.src : trigger.dataset.thumb || "";
        const full = trigger.dataset.full || (isImg ? largestSource(trigger) : "");

        // 先用缩略图顶上，避免黑屏；大图在后台加载完再替换
        image.src = thumb || full;
        image.alt = trigger.dataset.alt || (isImg ? trigger.alt : "") || "";
        image.classList.add("is-loading");
        openDialog();

        if (full && full !== thumb) {
          status.hidden = false;
          status.textContent = "正在加载大图…";
          const preload = new Image();
          preload.onload = () => {
            image.src = full;
            status.hidden = true;
          };
          preload.onerror = () => {
            status.textContent = "大图加载失败，先看这张";
            window.setTimeout(() => {
              status.hidden = true;
            }, 2400);
          };
          preload.src = full;
        }
      });
    });

    image.addEventListener("load", () => image.classList.remove("is-loading"));

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) close();
    });
    dialog.querySelector("[data-lightbox-close]").addEventListener("click", close);
  })();
</script>
