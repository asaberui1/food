---
import { siteConfig } from "../config/site";

type Props = {
  title?: string;
  description?: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  type?: "website" | "article";
  structuredData?: Record<string, unknown>;
};

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image = siteConfig.defaultImage,
  imageWidth,
  imageHeight,
  type = "website",
  structuredData,
} = Astro.props;

const siteUrl = Astro.site ?? new URL("http://localhost:4321");
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, siteUrl);

// 站点部署在 /food/ 下，站内图片路径要补上前缀（封面的路径本来就带）
const imagePath = image.startsWith(base) ? image : `${base}${image.replace(/^\//, "")}`;
const absoluteImage = new URL(imagePath, siteUrl);
const pageTitle = title === siteConfig.title ? title : `${title} | ${siteConfig.name}`;
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />
<meta property="og:locale" content={siteConfig.locale} />
<meta property="og:type" content={type} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:image" content={absoluteImage.href} />
{imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
{imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
<meta property="og:image:type" content={absoluteImage.pathname.endsWith(".png") ? "image/png" : "image/jpeg"} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteImage.href} />
{structuredData && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
)}
