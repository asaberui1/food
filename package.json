{
  "name": "chuangzhi-shidan",
  "version": "1.0.0",
  "description": "创智食单：上海创智学院周边餐馆指南，基于 Astro 的静态站点。",
  "type": "module",
  "license": "MIT",
  "author": "asaberui1",
  "homepage": "https://asaberui1.github.io/food/",
  "repository": {
    "type": "git",
    "url": "https://github.com/asaberui1/food.git"
  },
  "keywords": [
    "astro",
    "restaurant",
    "food-guide",
    "static-site",
    "github-pages"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/font-subset.mjs && node scripts/share-cards.mjs && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "og": "node scripts/og.mjs",
    "fonts": "node scripts/font-subset.mjs",
    "share": "node scripts/share-cards.mjs",
    "prebuild": "astro check",
    "test:search": "tsx scripts/search-test.ts",
    "test:fonts": "node scripts/font-audit.mjs",
    "audit:shops": "tsx scripts/audit-shops.ts",
    "geo": "node scripts/baidu-to-wgs.mjs",
    "postbuild": "npm run audit:aliases && npm run test:search && npm run audit:shops && npm run test:fonts",
    "audit:aliases": "tsx scripts/audit-aliases.ts"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.0",
    "fuse.js": "^7.5.0",
    "pinyin-pro": "^3.29.5",
    "sharp": "^0.35.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "prettier": "^3.8.4",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
